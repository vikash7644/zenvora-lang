{
  "name": "zenvora-lang",
  "displayName": "QORVYNT Lang",
  "description": "Syntax highlighting and language configuration for QORVYNT Lang (.zv).",
  "version": "0.1.0",
  "publisher": "zenvora",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenvora",
        "aliases": [
          "QORVYNT Lang",
          "qorvynt"
        ],
        "extensions": [
          ".zv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zenvora",
        "scopeName": "source.zenvora",
        "path": "./syntaxes/zenvora.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vikash7644/zenvora-lang.git"
  },
  "homepage": "https://github.com/vikash7644/zenvora-lang/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/vikash7644/zenvora-lang/issues"
  }
}
