{
  "name": "zenvora-lang",
  "displayName": "Zenvora Lang",
  "description": "Syntax highlighting and language configuration for Zenvora Lang (.zv).",
  "version": "0.1.0",
  "publisher": "zenvora",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zenvora",
        "aliases": [
          "Zenvora Lang",
          "zenvora"
        ],
        "extensions": [
          ".zv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zenvora",
        "scopeName": "source.zenvora",
        "path": "./syntaxes/zenvora.tmLanguage.json"
      }
    ]
  }
}
