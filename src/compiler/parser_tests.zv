define builtin_call_ast := parse_program(get(builtin_call_lexed, "tokens"))
define builtin_call_result := validate_program(get(builtin_call_ast, "ast"))
define bad_builtin_arity_lexed := lex("show len(array(1), array(2))\n")
define bad_builtin_arity_ast := parse_program(get(bad_builtin_arity_lexed, "tokens"))
define bad_builtin_arity_result := validate_program(get(bad_builtin_arity_ast, "ast"))
define bad_sum_arity_lexed := lex("show sum(array(1), array(2))\n")
define bad_sum_arity_ast := parse_program(get(bad_sum_arity_lexed, "tokens"))
define bad_sum_arity_result := validate_program(get(bad_sum_arity_ast, "ast"))
define bad_arity_lexed := lex("fn one(a) {\nreturn a\n}\nshow one(1, 2)\n")
