# Resource-limit regressions: malicious plans must terminate instead of hanging or overflowing the host stack.
define recursive_source := "fn recurse(n) {\nreturn recurse(n + 1)\n}\nshow recurse(0)\n"
define recursive_lexed := lex(recursive_source)
define recursive_ast := parse_program(get(recursive_lexed, "tokens"))
define recursive_ir := lower_program(get(recursive_ast, "ast"))
define recursive_plan := emit_bytecode_plan(recursive_ir)
define recursive_result := execute_bytecode_plan(recursive_plan)
show get(recursive_result, "error")

# The runtime instruction cap is covered by Rust VM tests; do not burn the host test budget here.


# Generic source-to-plan driver. This is the reusable pipeline entry point for
# supported source text; it does not claim standalone bootstrap/self-hosting.


# Direct Bytecode v2 artifact regression for the Zenvora-written backend.
define generic_driver_v2 := compile_source("define answer := 40 + 2\nshow answer\n")
define generic_driver_v2_result := get(generic_driver_v2, "bytecode")
if get(generic_driver_v2, "ok") and get(generic_driver_v2_result, "ok") and index_of(get(generic_driver_v2_result, "artifact"), "ZENVORA_BYTECODE 2") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "PUSH 40") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "ADD") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "PRINT") >= 0 {
  show "ZENVORA_WRITTEN_BYTECODE_V2_MAIN_PASS"
} otherwise {
  show "ZENVORA_WRITTEN_BYTECODE_V2_MAIN_FAIL"
  show generic_driver_v2
  show generic_driver_v2_result
}

define generic_driver_v2_flow := compile_source("define i := 0\nrepeat i < 2 {\ni := i + 1\n}\nif i == 2 {\nshow 42\n} otherwise {\nshow 0\n}\n")
define generic_driver_v2_flow_result := get(generic_driver_v2_flow, "bytecode")
if get(generic_driver_v2_flow, "ok") and get(generic_driver_v2_flow_result, "ok") and index_of(get(generic_driver_v2_flow_result, "artifact"), "JUMP_IF_FALSE") >= 0 and index_of(get(generic_driver_v2_flow_result, "artifact"), "JUMP ") >= 0 {
  show "ZENVORA_WRITTEN_BYTECODE_V2_CONTROL_FLOW_PASS"
} otherwise {
  show "ZENVORA_WRITTEN_BYTECODE_V2_CONTROL_FLOW_FAIL"
  show generic_driver_v2_flow
  show generic_driver_v2_flow_result
}

# Regression: the same entry point compiles distinct caller-provided programs,
# and malformed source fails at the correct stage rather than emitting a plan.
define generic_driver_a := compile_source("define answer := 40 + 2\nshow answer\n")
define generic_driver_b := compile_source("fn double(n) {\nreturn n * 2\n}\nshow double(21)\n")
define generic_driver_bad := compile_source("show (1 +\n")
define generic_driver_run_a := execute_bytecode_plan(get(generic_driver_a, "plan"))
define generic_driver_run_b := execute_bytecode_plan(get(generic_driver_b, "plan"))
if get(generic_driver_a, "ok") and get(generic_driver_b, "ok") and not get(generic_driver_bad, "ok") and get(generic_driver_bad, "stage") == "parse" and get(get(generic_driver_run_a, "output"), 0) == "42" and get(get(generic_driver_run_b, "output"), 0) == "42" {
  show "ZENVORA_GENERIC_COMPILER_DRIVER_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_DRIVER_FAIL"
  show generic_driver_a
  show generic_driver_b
  show generic_driver_bad
}


# Broader generic-driver regressions: lexical errors, semantic errors, and control flow
# must be handled by the same caller-source pipeline (not by the fixed demo harness).
define generic_driver_if := compile_source("if 1 < 2 {\nshow 9\n} otherwise {\nshow 0\n}\n")
define generic_driver_lex_bad := compile_source("show @\n")
define generic_driver_semantic_bad := compile_source("show missing_value\n")
define generic_driver_if_run := execute_bytecode_plan(get(generic_driver_if, "plan"))
if get(generic_driver_if, "ok") and get(generic_driver_if_run, "ok") and get(get(generic_driver_if_run, "output"), 0) == "9" and not get(generic_driver_lex_bad, "ok") and get(generic_driver_lex_bad, "stage") == "lex" and not get(generic_driver_semantic_bad, "ok") and get(generic_driver_semantic_bad, "stage") == "validate" {
  show "ZENVORA_GENERIC_COMPILER_STAGES_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_STAGES_FAIL"
  show generic_driver_if
  show generic_driver_lex_bad
  show generic_driver_semantic_bad
}


# Additional generic-driver coverage for collections and loop lowering.
define generic_driver_loop := compile_source("define total := 0\ndefine items := array(2, 3, 4)\ndefine i := 0\nrepeat i < len(items) {\ntotal := total + get(items, i)\ni := i + 1\n}\nshow total\n")
define generic_driver_loop_run := execute_bytecode_plan(get(generic_driver_loop, "plan"))
define generic_driver_bad_plan := map("format", "ZENVORA_BYTECODE_PLAN_1", "main", array(map("op", "unknown_opcode", "line", 1)), "functions", array())
define generic_driver_bad_verify := verify_bytecode_plan(generic_driver_bad_plan)
if get(generic_driver_loop, "ok") and get(generic_driver_loop_run, "ok") and get(get(generic_driver_loop_run, "output"), 0) == "9" and not get(generic_driver_bad_verify, "ok") and get(generic_driver_bad_verify, "error") == "main: unsupported bytecode opcode: unknown_opcode" {
  show "ZENVORA_GENERIC_COMPILER_COLLECTION_LOOP_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_COLLECTION_LOOP_FAIL"
  show generic_driver_loop
  show generic_driver_loop_run
  show generic_driver_bad_verify
}

# Regression: jump targets from separate top-level control-flow statements
# must share one main instruction stream. This catches per-statement offset resets.
define generic_driver_multi_control := compile_source("if false {\nshow 99\n} otherwise {\nshow 1\n}\ndefine loop_i := 0\nrepeat loop_i < 2 {\nloop_i := loop_i + 1\nshow loop_i\n}\nshow 42\n")
define generic_driver_multi_run := execute_bytecode_plan(get(generic_driver_multi_control, "plan"))
define generic_driver_multi_output := get(generic_driver_multi_run, "output")
if get(generic_driver_multi_control, "ok") and get(generic_driver_multi_run, "ok") and len(generic_driver_multi_output) == 4 and get(generic_driver_multi_output, 0) == "1" and get(generic_driver_multi_output, 1) == "1" and get(generic_driver_multi_output, 2) == "2" and get(generic_driver_multi_output, 3) == "42" {
  show "ZENVORA_MULTI_CONTROL_FLOW_PLAN_PASS"
} otherwise {
  show "ZENVORA_MULTI_CONTROL_FLOW_PLAN_FAIL"
  show generic_driver_multi_control
  show generic_driver_multi_run
}



# Compiler-driver semantic regressions: recursive functions, function-local names,
# duplicate parameters, and call arity must be checked through compile_source().
define generic_driver_recursive := compile_source("fn sum_to(n) {\nif n <= 0 {\nreturn 0\n} otherwise {\ndefine previous := sum_to(n - 1)\nreturn n + previous\n}\n}\nshow sum_to(3)\n")
define generic_driver_recursive_run := execute_bytecode_plan(get(generic_driver_recursive, "plan"))
define generic_driver_undefined_local := compile_source("fn broken(value) {\nreturn value + missing_local\n}\nshow broken(1)\n")
define generic_driver_duplicate_params := compile_source("fn broken(value, value) {\nreturn value\n}\nshow broken(1, 2)\n")
define generic_driver_wrong_arity := compile_source("fn double(value) {\nreturn value * 2\n}\nshow double(1, 2)\n")
if get(generic_driver_recursive, "ok") and get(generic_driver_recursive_run, "ok") and get(get(generic_driver_recursive_run, "output"), 0) == "6" and not get(generic_driver_undefined_local, "ok") and get(generic_driver_undefined_local, "stage") == "validate" and not get(generic_driver_duplicate_params, "ok") and get(generic_driver_duplicate_params, "stage") == "validate" and not get(generic_driver_wrong_arity, "ok") and get(generic_driver_wrong_arity, "stage") == "validate" {
  show "ZENVORA_GENERIC_COMPILER_FUNCTION_SEMANTICS_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_FUNCTION_SEMANTICS_FAIL"
  show generic_driver_recursive
  show generic_driver_recursive_run
  show generic_driver_undefined_local
  show generic_driver_duplicate_params
  show generic_driver_wrong_arity
}


# Truthiness matches the reference VM: booleans and integers are valid conditions; strings are rejected.
define generic_driver_truthy := compile_source("if 1 {\nshow 1\n} otherwise {\nshow 0\n}\nif 0 {\nshow 0\n} otherwise {\nshow 2\n}\nif -1 {\nshow 3\n} otherwise {\nshow 0\n}\nif true {\nshow 4\n} otherwise {\nshow 0\n}\nif false {\nshow 0\n} otherwise {\nshow 5\n}\n")
define generic_driver_truthy_run := execute_bytecode_plan(get(generic_driver_truthy, "plan"))
define generic_driver_string_condition := compile_source("if \"hello\" {\nshow 1\n}\n")
define generic_driver_string_condition_run := execute_bytecode_plan(get(generic_driver_string_condition, "plan"))
if get(generic_driver_truthy, "ok") and get(generic_driver_truthy_run, "ok") and len(get(generic_driver_truthy_run, "output")) == 5 and get(get(generic_driver_truthy_run, "output"), 0) == "1" and get(get(generic_driver_truthy_run, "output"), 1) == "2" and get(get(generic_driver_truthy_run, "output"), 2) == "3" and get(get(generic_driver_truthy_run, "output"), 3) == "4" and get(get(generic_driver_truthy_run, "output"), 4) == "5" and get(generic_driver_string_condition, "ok") and not get(generic_driver_string_condition_run, "ok") and get(generic_driver_string_condition_run, "error") == "type error: condition expects a boolean or integer" {
  show "ZENVORA_VM_TRUTHINESS_PASS"
} otherwise {
  show "ZENVORA_VM_TRUTHINESS_FAIL"
  show json_encode(generic_driver_truthy)
  show json_encode(generic_driver_truthy_run)
  show json_encode(generic_driver_string_condition)
  show json_encode(generic_driver_string_condition_run)
}

# Explicitly report indirect-call IR as unsupported instead of silently falling through.
define indirect_call_emission := emit_expression(array(map("op", "call_indirect", "argc", 1, "line", 1)))
if len(indirect_call_emission) == 1 and get(get(indirect_call_emission, 0), "op") == "compile_error" and get(get(indirect_call_emission, 0), "message") == "indirect calls are not supported by the bytecode-plan VM" {
  show "ZENVORA_INDIRECT_CALL_REJECTED_PASS"
} otherwise {
  show "ZENVORA_INDIRECT_CALL_REJECTED_FAIL"
  show indirect_call_emission
}

# A function body followed by a new top-level statement must parse and execute.
define multiline_function_driver := compile_source("fn add(a, b) {\nreturn a + b\n}\nshow add(20, 22)\n")
define multiline_function_run := execute_bytecode_plan(get(multiline_function_driver, "plan"))
if get(multiline_function_driver, "ok") and get(multiline_function_run, "ok") and get(get(multiline_function_run, "output"), 0) == "42" {
  show "ZENVORA_MULTILINE_FUNCTION_BOUNDARY_PASS"
} otherwise {
  show "ZENVORA_MULTILINE_FUNCTION_BOUNDARY_FAIL"
  show multiline_function_driver
  show multiline_function_run
}

# The self-hosted v2 emitter lowers verified built-in calls to the canonical BUILTIN opcode.
define generic_driver_v2_builtin := compile_source("show abs(-5)")
define generic_driver_v2_builtin_result := get(generic_driver_v2_builtin, "bytecode")
if get(generic_driver_v2_builtin, "ok") and get(generic_driver_v2_builtin_result, "ok") and index_of(get(generic_driver_v2_builtin_result, "artifact"), "BUILTIN abs 1") >= 0 {
  show "ZENVORA_WRITTEN_BYTECODE_V2_BUILTIN_PASS"
} otherwise {
  show "ZENVORA_WRITTEN_BYTECODE_V2_BUILTIN_FAIL"
  show generic_driver_v2_builtin
  show generic_driver_v2_builtin_result
}
