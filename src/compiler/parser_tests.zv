define invalid_break_result := validate_program(get(invalid_break_ast, "ast"))
define nested_function_lexed := lex("fn outer() {\nfn inner() {\nreturn 1\n}\nreturn 2\n}\n")
define nested_function_ast := parse_program(get(nested_function_lexed, "tokens"))
define nested_function_result := validate_program(get(nested_function_ast, "ast"))
define invalid_return_lexed := lex("return 1\n")
define invalid_return_ast := parse_program(get(invalid_return_lexed, "tokens"))
define invalid_return_result := validate_program(get(invalid_return_ast, "ast"))
show builtin_call_ast
show "ZENVORA_SEMANTICS"
if get(builtin_call_result, "ok") {
  show "ZENVORA_BUILTIN_CALL_PASS"
} otherwise {
  show "ZENVORA_BUILTIN_CALL_FAIL"
}
show valid_semantic_result
show get(bad_call_result, "error")
show get(bad_variable_result, "error")
show get(bad_assignment_result, "error")
show get(bad_arity_result, "error")
show get(invalid_break_result, "error")
show get(invalid_return_result, "error")
show get(nested_function_result, "error")
show get(bad_builtin_arity_result, "error")
show get(bad_sum_arity_result, "error")

