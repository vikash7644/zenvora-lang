define parser_source := "define answer := 2 + 3 * 4\nshow answer\ndefine negative := -2\ndefine inverted := not false\ndefine called := sum(1, 2 + 3)\ndefine first_item := values[0]\ndefine logic := true or false and false\nif answer > 0 { show answer } otherwise { show 0 }\nrepeat answer > 0 { answer := answer - 1 }\nfn add(a, b) { if a > 0 { return a + b } otherwise { return b } }\nanswer := 42\nreturn answer\nbreak\ncontinue\n"
define lexed := lex(parser_source)
define parser_tokens := get(lexed, "tokens")
define parsed := parse_program(parser_tokens)
define parsed_ast := get(parsed, "ast")
define first := get(parsed_ast, 0)
define first_expr := get(first, "left")
define multiplied := get(first_expr, "right")
define negative_statement := get(parsed_ast, 2)
define negative_expr := get(negative_statement, "left")
define inverted_statement := get(parsed_ast, 3)
define inverted_expr := get(inverted_statement, "left")
define call_statement := get(parsed_ast, 4)
define call_expr := get(call_statement, "left")
define index_statement := get(parsed_ast, 5)
define index_expr := get(index_statement, "left")
define logic_statement := get(parsed_ast, 6)
define logic_expr := get(logic_statement, "left")
define if_statement := get(parsed_ast, 7)
define repeat_statement := get(parsed_ast, 8)
define function_statement := get(parsed_ast, 9)
define assignment_statement := get(parsed_ast, 10)
define return_statement := get(parsed_ast, 11)
define break_statement := get(parsed_ast, 12)
define continue_statement := get(parsed_ast, 13)
define bad_lexed := lex("define broken :=\n")
define bad_tokens := get(bad_lexed, "tokens")
define bad_parse := parse_program(bad_tokens)
define bad_call_lexed := lex("define broken := sum(1,)\n")
define bad_call_parse := parse_program(get(bad_call_lexed, "tokens"))
define bad_index_lexed := lex("define broken := values[0\n")
define bad_index_parse := parse_program(get(bad_index_lexed, "tokens"))
define bad_group_lexed := lex("define broken := (1 + 2\n")
define bad_group_parse := parse_program(get(bad_group_lexed, "tokens"))
define bad_return_lexed := lex("return\n")
define bad_return_parse := parse_program(get(bad_return_lexed, "tokens"))
define bad_assign_lexed := lex("answer :=\n")
define bad_assign_parse := parse_program(get(bad_assign_lexed, "tokens"))
define bad_fn_param_lexed := lex("fn bad(1) { show 1 }\n")
define bad_fn_param_parse := parse_program(get(bad_fn_param_lexed, "tokens"))
define bad_fn_block_lexed := lex("fn bad(a) { show a\n")
define bad_fn_block_parse := parse_program(get(bad_fn_block_lexed, "tokens"))
show get(lexed, "error")
show get(parsed, "error")
show get(first, "kind")
show get(first_expr, "value")
show get(multiplied, "value")
show get(negative_expr, "kind")
show get(negative_expr, "value")
show get(inverted_expr, "kind")
show get(inverted_expr, "value")
show get(call_expr, "kind")
show get(index_expr, "kind")
show get(logic_expr, "value")
show get(get(logic_expr, "right"), "value")
show get(if_statement, "kind")
show get(repeat_statement, "kind")
show get(function_statement, "kind")
show get(function_statement, "value")
show get(function_statement, "left")
show get(get(get(function_statement, "right"), 0), "kind")
show get(assignment_statement, "kind")
show get(return_statement, "kind")
show get(break_statement, "kind")
show get(continue_statement, "kind")
show get(bad_parse, "error")
show get(bad_call_parse, "error")
show get(bad_index_parse, "error")
show get(bad_group_parse, "error")
show get(bad_return_parse, "error")
show get(bad_assign_parse, "error")
show get(bad_fn_param_parse, "error")
show get(bad_fn_block_parse, "error")

# Regression: braces inside string tokens must not terminate a function body.
define brace_string_source := "fn braces() {\nshow \"}\"\nshow \"{\"\n}\nshow \"done\"\n"
define brace_string_lexed := lex(brace_string_source)
define brace_string_parse := parse_program(get(brace_string_lexed, "tokens"))
if get(brace_string_parse, "error") == "" and len(get(brace_string_parse, "ast")) == 2 {
  show "ZENVORA_BRACE_STRING_PASS"
} otherwise {
  show "ZENVORA_BRACE_STRING_FAIL"
}
show parsed

# Minimal Zenvora-written bytecode-plan VM. This executes emitted instructions in Zenvora,
# rather than asking the Rust reference VM to execute the plan.
fn pop_stack(stack) {
  if len(stack) == 0 {
    return map("stack", stack, "value", "", "error", "operand stack underflow")
  }
  define last := get(stack, len(stack) - 1)
  define rest := array()
  define i := 0
  repeat i < len(stack) - 1 {
    rest := push(rest, get(stack, i))
    i := i + 1
  }
  return map("stack", rest, "value", last, "error", "")
}
fn vm_truthy(value) {
  if type_of(value) == "boolean" {
    return value
  } otherwise {
    if type_of(value) == "number" {
      return value != 0
    } otherwise {
      if type_of(value) == "string" {
        return char_count(value) > 0
      } otherwise {
        return true
      }
    }
  }
}
fn vm_binary(operator, left, right) {
  if operator == "+" {
    if type_of(left) == "string" or type_of(right) == "string" {
      return map("value", to_string(left) + to_string(right), "error", "")
    }
    return map("value", left + right, "error", "")
  } otherwise {
    if operator == "-" {
      return map("value", left - right, "error", "")
    } otherwise {
      if operator == "*" {
        return map("value", left * right, "error", "")
      } otherwise {
        if operator == "/" {
          if right == 0 {
            return map("value", 0, "error", "division by zero")
          }
          return map("value", left / right, "error", "")
        } otherwise {
          if operator == "==" {
            return map("value", left == right, "error", "")
          } otherwise {
            if operator == "!=" {
              return map("value", left != right, "error", "")
            } otherwise {
              if operator == "<" {
                return map("value", left < right, "error", "")
              } otherwise {
                if operator == "<=" {
                  return map("value", left <= right, "error", "")
                } otherwise {
                  if operator == ">" {
                    return map("value", left > right, "error", "")
                  } otherwise {
                    if operator == ">=" {
                      return map("value", left >= right, "error", "")
                    } otherwise {
                      if operator == "and" {
                        return map("value", left and right, "error", "")
                      } otherwise {
                        if operator == "or" {
                          return map("value", left or right, "error", "")
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return map("value", "", "error", "unsupported binary operator: " + operator)
}
# Execute the initial builtin subset directly in the Zenvora-authored plan VM.
# Arguments arrive in reverse stack-pop order and are normalized here.
fn execute_plan_builtin(name, reversed_args) {
  define args := array()
  define pos := len(reversed_args) - 1
  repeat pos >= 0 {
    args := push(args, get(reversed_args, pos))
    pos := pos - 1
  }
  # Expand execution parity with the VM's established string and collection built-ins.
  if name == "starts_with" and len(args) == 2 {
    return map("ok", true, "value", starts_with(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "ends_with" and len(args) == 2 {
    return map("ok", true, "value", ends_with(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "trim" and len(args) == 1 {
    return map("ok", true, "value", trim(get(args, 0)), "error", "")
  }
  if name == "lower" and len(args) == 1 {
    return map("ok", true, "value", lower(get(args, 0)), "error", "")
  }
  if name == "upper" and len(args) == 1 {
    return map("ok", true, "value", upper(get(args, 0)), "error", "")
  }
  if name == "char_count" and len(args) == 1 {
    return map("ok", true, "value", char_count(get(args, 0)), "error", "")
  }
  if name == "index_of" and len(args) == 2 {
    return map("ok", true, "value", index_of(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "contains" and len(args) == 2 {
    return map("ok", true, "value", contains(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "get" and len(args) == 2 {
    return map("ok", true, "value", get(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "push" and len(args) == 2 {
    return map("ok", true, "value", push(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "keys" and len(args) == 1 {
    return map("ok", true, "value", keys(get(args, 0)), "error", "")
  }
  if name == "values" and len(args) == 1 {
    return map("ok", true, "value", values(get(args, 0)), "error", "")
  }
  if name == "replace" and len(args) == 3 {
    return map("ok", true, "value", replace(get(args, 0), get(args, 1), get(args, 2)), "error", "")
  }
  if name == "split" and len(args) == 2 {
    return map("ok", true, "value", split(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "join" and len(args) == 2 {
    return map("ok", true, "value", join(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "clamp" and len(args) == 3 {
    return map("ok", true, "value", clamp(get(args, 0), get(args, 1), get(args, 2)), "error", "")
  }
  if name == "unique" and len(args) == 1 {
    return map("ok", true, "value", unique(get(args, 0)), "error", "")
  }
  if name == "to_int" and len(args) == 1 {
    return map("ok", true, "value", to_int(get(args, 0)), "error", "")
  }
  if name == "range" and len(args) == 2 {
    return map("ok", true, "value", range(get(args, 0), get(args, 1)), "error", "")
  }
  if name == "assert" and len(args) == 1 {
    if not get(args, 0) {
      return map("ok", false, "value", "", "error", "assertion failed")
    }
    return map("ok", true, "value", true, "error", "")
  }
  if name == "assert_eq" and len(args) == 2 {
    if get(args, 0) != get(args, 1) {
      return map("ok", false, "value", "", "error", "assertion failed: values are not equal")
    }
    return map("ok", true, "value", true, "error", "")
  }
  if name == "is_prime" and len(args) == 1 {
    define prime_n := get(args, 0)
    if type_of(prime_n) != "integer" {
      return map("ok", false, "value", "", "error", "type error: is_prime expects an integer")
    }
    if prime_n < 2 {
      return map("ok", true, "value", false, "error", "")
    }
    if prime_n == 2 {
      return map("ok", true, "value", true, "error", "")
    }
    if prime_n == (prime_n / 2) * 2 {
      return map("ok", true, "value", false, "error", "")
    }
    define prime_divisor := 3
    define prime_result := true
    repeat prime_divisor <= prime_n / prime_divisor and prime_result {
      if prime_n == (prime_n / prime_divisor) * prime_divisor {
        prime_result := false
      }
      prime_divisor := prime_divisor + 2
    }
    return map("ok", true, "value", prime_result, "error", "")
  }
  if name == "gcd" and len(args) == 2 {
    define gcd_a := get(args, 0)
    define gcd_b := get(args, 1)
    if type_of(gcd_a) != "integer" or type_of(gcd_b) != "integer" {
      return map("ok", false, "value", "", "error", "type error: gcd expects two integers")
    }
    if gcd_a < 0 {
      gcd_a := 0 - gcd_a
    }
    if gcd_b < 0 {
      gcd_b := 0 - gcd_b
    }
    repeat gcd_b != 0 {
      define gcd_remainder := gcd_a - (gcd_a / gcd_b) * gcd_b
      gcd_a := gcd_b
      gcd_b := gcd_remainder
    }
    return map("ok", true, "value", gcd_a, "error", "")
  }
  if name == "lcm" and len(args) == 2 {
    define lcm_a := get(args, 0)
    define lcm_b := get(args, 1)
    if type_of(lcm_a) != "integer" or type_of(lcm_b) != "integer" {
      return map("ok", false, "value", "", "error", "type error: lcm expects two integers")
    }
    if lcm_a == 0 or lcm_b == 0 {
      return map("ok", true, "value", 0, "error", "")
    }
    if lcm_a < 0 {
      lcm_a := 0 - lcm_a
    }
    if lcm_b < 0 {
      lcm_b := 0 - lcm_b
    }
    define lcm_x := lcm_a
    define lcm_y := lcm_b
    repeat lcm_y != 0 {
      define lcm_remainder := lcm_x - (lcm_x / lcm_y) * lcm_y
      lcm_x := lcm_y
      lcm_y := lcm_remainder
    }
    return map("ok", true, "value", (lcm_a / lcm_x) * lcm_b, "error", "")
  }
  if name == "dna_complement" and len(args) == 1 {
    define dna_sequence := upper(get(args, 0))
    if type_of(dna_sequence) != "string" {
      return map("ok", false, "value", "", "error", "type error: dna_complement expects a DNA string")
    }
    define dna_result := ""
    define dna_pos := 0
    repeat dna_pos < char_count(dna_sequence) {
      define dna_base := char_at(dna_sequence, dna_pos)
      if dna_base == "A" {
        dna_result := dna_result + "T"
      } otherwise {
        if dna_base == "T" {
          dna_result := dna_result + "A"
        } otherwise {
          if dna_base == "C" {
            dna_result := dna_result + "G"
          } otherwise {
            if dna_base == "G" {
              dna_result := dna_result + "C"
            } otherwise {
              return map("ok", false, "value", "", "error", "dna_complement found an invalid DNA base")
            }
          }
        }
      }
      dna_pos := dna_pos + 1
    }
    return map("ok", true, "value", dna_result, "error", "")
  }
  if name == "gc_content_percent" and len(args) == 1 {
    define gc_sequence := upper(get(args, 0))
    if type_of(gc_sequence) != "string" {
      return map("ok", false, "value", "", "error", "type error: gc_content_percent expects a DNA string")
    }
    if char_count(gc_sequence) == 0 {
      return map("ok", false, "value", "", "error", "gc_content_percent cannot use an empty DNA string")
    }
    define gc_total := 0
    define gc_pos := 0
    repeat gc_pos < char_count(gc_sequence) {
      define gc_base := char_at(gc_sequence, gc_pos)
      if gc_base == "G" or gc_base == "C" {
        gc_total := gc_total + 1
      } otherwise {
        if gc_base != "A" and gc_base != "T" {
          return map("ok", false, "value", "", "error", "gc_content_percent found an invalid DNA base")
        }
      }
      gc_pos := gc_pos + 1
    }
    return map("ok", true, "value", (gc_total * 100) / char_count(gc_sequence), "error", "")
  }
  if name == "factorial" and len(args) == 1 {
    define n := get(args, 0)
    if type_of(n) != "integer" or n < 0 or n > 20 {
      return map("ok", false, "value", "", "error", "factorial expects an integer from 0 through 20")
    }
    define factorial_result := 1
    define factorial_i := 2
    repeat factorial_i <= n {
      factorial_result := factorial_result * factorial_i
      factorial_i := factorial_i + 1
    }
    return map("ok", true, "value", factorial_result, "error", "")
  }
  if name == "fibonacci" and len(args) == 1 {
    define n := get(args, 0)
    if type_of(n) != "integer" or n < 0 or n > 92 {
      return map("ok", false, "value", "", "error", "fibonacci expects an integer from 0 through 92")
    }
    define fib_a := 0
    define fib_b := 1
    define fib_i := 0
    repeat fib_i < n {
      define fib_next := fib_a + fib_b
      fib_a := fib_b
      fib_b := fib_next
      fib_i := fib_i + 1
    }
    return map("ok", true, "value", fib_a, "error", "")
  }
  if name == "pow_int" and len(args) == 2 {
    define pow_base := get(args, 0)
    define pow_exponent := get(args, 1)
    if type_of(pow_base) != "integer" or type_of(pow_exponent) != "integer" {
      return map("ok", false, "value", "", "error", "type error: pow_int expects two integers")
    }
    if pow_exponent < 0 or pow_exponent > 63 {
      return map("ok", false, "value", "", "error", "pow_int exponent must be from 0 through 63")
    }
    define pow_result := 1
    define pow_i := 0
    repeat pow_i < pow_exponent {
      pow_result := pow_result * pow_base
      pow_i := pow_i + 1
    }
    return map("ok", true, "value", pow_result, "error", "")
  }
  if name == "mean" and len(args) == 1 {
    define mean_items := get(args, 0)
    if type_of(mean_items) != "array" {
      return map("ok", false, "value", "", "error", "type error: mean expects an array of integers")
    }
    if len(mean_items) == 0 {
      return map("ok", false, "value", "", "error", "mean cannot be used with an empty array")
    }
    define mean_total := 0
    define mean_i := 0
    repeat mean_i < len(mean_items) {
      define mean_item := get(mean_items, mean_i)
      if type_of(mean_item) != "integer" {
        return map("ok", false, "value", "", "error", "type error: mean expects an array containing only integers")
      }
      mean_total := mean_total + mean_item
      mean_i := mean_i + 1
    }
    return map("ok", true, "value", mean_total / len(mean_items), "error", "")
  }
  if (name == "speed" or name == "density" or name == "molarity") and len(args) == 2 {
    define ratio_numerator := get(args, 0)
    define ratio_denominator := get(args, 1)
    if type_of(ratio_numerator) != "integer" or type_of(ratio_denominator) != "integer" {
      return map("ok", false, "value", "", "error", "type error: " + name + " expects two integers")
    }
    if ratio_denominator <= 0 {
      return map("ok", false, "value", "", "error", name + " denominator must be positive")
    }
    return map("ok", true, "value", ratio_numerator / ratio_denominator, "error", "")
  }
  if name == "force" and len(args) == 2 {
    define force_mass := get(args, 0)
    define force_acceleration := get(args, 1)
    if type_of(force_mass) != "integer" or type_of(force_acceleration) != "integer" {
      return map("ok", false, "value", "", "error", "type error: force expects mass and acceleration as integers")
    }
    return map("ok", true, "value", force_mass * force_acceleration, "error", "")
  }
  if name == "kinetic_energy" and len(args) == 2 {
    define energy_mass := get(args, 0)
    define energy_velocity := get(args, 1)
    if type_of(energy_mass) != "integer" or type_of(energy_velocity) != "integer" {
      return map("ok", false, "value", "", "error", "type error: kinetic_energy expects mass and velocity as integers")
    }
    if energy_mass < 0 {
      return map("ok", false, "value", "", "error", "kinetic_energy mass cannot be negative")
    }
    return map("ok", true, "value", (energy_mass * energy_velocity * energy_velocity) / 2, "error", "")
  }
  if name == "bmi_x10" and len(args) == 2 {
    define bmi_mass := get(args, 0)
    define bmi_height := get(args, 1)
    if type_of(bmi_mass) != "integer" or type_of(bmi_height) != "integer" {
      return map("ok", false, "value", "", "error", "type error: bmi_x10 expects mass in kg and height in cm as integers")
    }
    if bmi_mass <= 0 or bmi_height <= 0 {
      return map("ok", false, "value", "", "error", "bmi_x10 mass and height must be positive")
    }
    return map("ok", true, "value", (bmi_mass * 100000) / (bmi_height * bmi_height), "error", "")
  }
  if name == "molar_mass" and len(args) == 1 {
    define masses := get(args, 0)
    if type_of(masses) != "array" {
      return map("ok", false, "value", "", "error", "type error: molar_mass expects an array of integer atomic masses")
    }
    if len(masses) == 0 {
      return map("ok", false, "value", "", "error", "molar_mass expects at least one atomic mass")
    }
    define mass_total := 0
    define mass_i := 0
    repeat mass_i < len(masses) {
      define atomic_mass := get(masses, mass_i)
      if type_of(atomic_mass) != "integer" or atomic_mass < 0 {
        return map("ok", false, "value", "", "error", "molar_mass expects non-negative integer atomic masses")
      }
      mass_total := mass_total + atomic_mass
      mass_i := mass_i + 1
    }
    return map("ok", true, "value", mass_total, "error", "")
  }
  if name == "map" {
    define result_map := map()
    define map_pos := 0
    repeat map_pos + 1 < len(args) {
      result_map := put(result_map, get(args, map_pos), get(args, map_pos + 1))
      map_pos := map_pos + 2
    }
    if map_pos < len(args) {
      return map("ok", false, "value", "", "error", "map expects key/value pairs")
    }
    return map("ok", true, "value", result_map, "error", "")
  }
  if name == "put" and len(args) == 3 {
    return map("ok", true, "value", put(get(args, 0), get(args, 1), get(args, 2)), "error", "")
  }
  if name == "array" {
    return map("ok", true, "value", args, "error", "")
  } otherwise {
    if name == "len" and len(args) == 1 {
      return map("ok", true, "value", len(get(args, 0)), "error", "")
    } otherwise {
      if name == "sum" and len(args) == 1 and type_of(get(args, 0)) == "array" {
        return map("ok", true, "value", sum(get(args, 0)), "error", "")
      } otherwise {
        if name == "char_at" and len(args) == 2 and type_of(get(args, 0)) == "string" and type_of(get(args, 1)) == "integer" and get(args, 1) >= 0 {
          if get(args, 1) < char_count(get(args, 0)) {
            return map("ok", true, "value", char_at(get(args, 0), get(args, 1)), "error", "")
          }
          return map("ok", false, "value", "", "error", "char_at index out of bounds")
        } otherwise {
          if name == "to_string" and len(args) == 1 {
            return map("ok", true, "value", to_string(get(args, 0)), "error", "")
          } otherwise {
            if name == "type_of" and len(args) == 1 {
              return map("ok", true, "value", type_of(get(args, 0)), "error", "")
            } otherwise {
              if name == "abs" and len(args) == 1 and type_of(get(args, 0)) == "integer" {
                return map("ok", true, "value", abs(get(args, 0)), "error", "")
              } otherwise {
                if name == "min" and len(args) == 2 {
                  return map("ok", true, "value", min(get(args, 0), get(args, 1)), "error", "")
                } otherwise {
                  if name == "max" and len(args) == 2 {
                    return map("ok", true, "value", max(get(args, 0), get(args, 1)), "error", "")
                  } otherwise {
                    if name == "first" and len(args) == 1 and type_of(get(args, 0)) == "array" and len(get(args, 0)) > 0 {
                      return map("ok", true, "value", get(get(args, 0), 0), "error", "")
                    } otherwise {
                      if name == "last" and len(args) == 1 and type_of(get(args, 0)) == "array" and len(get(args, 0)) > 0 {
                        return map("ok", true, "value", get(get(args, 0), len(get(args, 0)) - 1), "error", "")
                      } otherwise {
                        if name == "is_empty" and len(args) == 1 {
                          return map("ok", true, "value", len(get(args, 0)) == 0, "error", "")
                        } otherwise {
                          if name == "reverse" and len(args) == 1 and type_of(get(args, 0)) == "array" {
                            define reversed := array()
                            define item_pos := len(get(args, 0)) - 1
                            repeat item_pos >= 0 {
                              reversed := push(reversed, get(get(args, 0), item_pos))
                              item_pos := item_pos - 1
                            }
                            return map("ok", true, "value", reversed, "error", "")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return map("ok", false, "value", "", "error", "built-in is not yet supported by the Zenvora VM: " + name)
}

fn execute_plan_code(code, initial_env, initial_output, functions, call_depth) {
  if call_depth > 64 {
    return map("environment", initial_env, "output", initial_output, "error", "function call depth limit exceeded", "returned", false, "return_value", "")
  }
  define env := initial_env
  define output := initial_output
  define stack := array()
  define pc := 0
  define steps := 0
  define err := ""
  define returned := false
  define return_value := ""
  repeat pc < len(code) and err == "" and not returned and steps < 500 {
    steps := steps + 1
    define ins := get(code, pc)
    define op := get(ins, "op")
    if op == "push_const" {
      define value := get(ins, "value")
      if get(ins, "type") == "number" {
        value := to_int(value)
      } otherwise {
        if get(ins, "type") == "boolean" {
          value := value == "true"
        }
      }
      stack := push(stack, value)
    } otherwise {
      if op == "load" {
        define name := get(ins, "name")
        if not contains(env, name) {
          err := "undefined variable: " + name
        } otherwise {
          stack := push(stack, get(env, name))
        }
      } otherwise {
        if op == "declare" or op == "store" {
          define popped := pop_stack(stack)
          stack := get(popped, "stack")
          if get(popped, "error") != "" {
            err := get(popped, "error")
          } otherwise {
            env := put(env, get(ins, "name"), get(popped, "value"))
          }
        } otherwise {
          if op == "print" {
            define popped := pop_stack(stack)
            stack := get(popped, "stack")
            if get(popped, "error") != "" {
              err := get(popped, "error")
            } otherwise {
              output := push(output, to_string(get(popped, "value")))
            }
          } otherwise {
            if op == "unary" {
              define popped := pop_stack(stack)
              stack := get(popped, "stack")
              if get(popped, "error") != "" {
                err := get(popped, "error")
              } otherwise {
                define value := get(popped, "value")
                define operator := get(ins, "operator")
                if operator == "-" {
                  stack := push(stack, 0 - value)
                } otherwise {
                  if operator == "!" or operator == "not" {
                    stack := push(stack, not value)
                  } otherwise {
                    err := "unsupported unary operator: " + operator
                  }
                }
              }
            } otherwise {
              if op == "binary" {
                define right := pop_stack(stack)
                stack := get(right, "stack")
                define left := pop_stack(stack)
                stack := get(left, "stack")
                if get(right, "error") != "" or get(left, "error") != "" {
                  err := "operand stack underflow"
                } otherwise {
                  define evaluated := vm_binary(get(ins, "operator"), get(left, "value"), get(right, "value"))
                  if get(evaluated, "error") != "" {
                    err := get(evaluated, "error")
                  } otherwise {
                    stack := push(stack, get(evaluated, "value"))
                  }
                }
              } otherwise {
                if op == "index" {
                  define index_value := pop_stack(stack)
                  stack := get(index_value, "stack")
                  define collection := pop_stack(stack)
                  stack := get(collection, "stack")
                  if get(index_value, "error") != "" or get(collection, "error") != "" {
                    err := "operand stack underflow"
                  } otherwise {
                    define index := get(index_value, "value")
                    define target := get(collection, "value")
                    if type_of(index) != "integer" or index < 0 or index >= len(target) {
                      err := "invalid collection index"
                    } otherwise {
                      stack := push(stack, get(target, index))
                    }
                  }
                } otherwise {
                  if op == "jump" {
                    pc := get(ins, "target") - 1
                  } otherwise {
                    if op == "jump_if_false" {
                      define popped := pop_stack(stack)
                      stack := get(popped, "stack")
                      if get(popped, "error") != "" {
                        err := get(popped, "error")
                      } otherwise {
                        define condition_value := get(popped, "value")
                        define condition_truthy := true
                        if type_of(condition_value) == "boolean" {
                          condition_truthy := condition_value
                        } otherwise {
                          if type_of(condition_value) == "number" {
                            condition_truthy := condition_value != 0
                          } otherwise {
                            if type_of(condition_value) == "string" {
                              condition_truthy := char_count(condition_value) > 0
                            }
                          }
                        }
                        if not condition_truthy {
                          pc := get(ins, "target") - 1
                        }
                      }
                    } otherwise {
                      if op == "call" {
                        define fn_name := get(ins, "name")
                        define argc := get(ins, "argc")
                        define args := array()
                        define arg_pos := 0
                        if len(stack) < argc {
                          err := "operand stack underflow in function call"
                        } otherwise {
                          repeat arg_pos < argc {
                            define popped_arg := pop_stack(stack)
                            stack := get(popped_arg, "stack")
                            args := push(args, get(popped_arg, "value"))
                            arg_pos := arg_pos + 1
                          }
                          define fn_index := 0
                          define found_fn := false
                          repeat fn_index < len(functions) and not found_fn and err == "" {
                            define fn_record := get(functions, fn_index)
                            if get(fn_record, "name") == fn_name {
                              found_fn := true
                              define params := get(fn_record, "parameters")
                              if len(params) != argc {
                                err := "function argument count mismatch: " + fn_name
                              } otherwise {
                                define fn_env := env
                                define param_pos := 0
                                repeat param_pos < len(params) {
                                  fn_env := put(fn_env, get(params, param_pos), get(args, argc - param_pos - 1))
                                  param_pos := param_pos + 1
                                }
                                define called := execute_plan_code(get(fn_record, "code"), fn_env, output, functions, call_depth + 1)
                                output := get(called, "output")
                                if get(called, "error") != "" {
                                  err := get(called, "error")
                                } otherwise {
                                  stack := push(stack, get(called, "return_value"))
                                }
                              }
                            }
                            fn_index := fn_index + 1
                          }
                          if not found_fn and err == "" {
                            if is_builtin_function(fn_name) {
                              define builtin_result := execute_plan_builtin(fn_name, args)
                              if get(builtin_result, "ok") {
                                stack := push(stack, get(builtin_result, "value"))
                              } otherwise {
                                err := get(builtin_result, "error")
                              }
                            } otherwise {
                              err := "undefined function: " + fn_name
                            }
                          }
                        }
                      } otherwise {
                        if op == "return" {
                          returned := true
                          if len(stack) > 0 {
                            define popped_return := pop_stack(stack)
                            stack := get(popped_return, "stack")
                            return_value := get(popped_return, "value")
                          }
                        } otherwise {
                          err := "unsupported VM opcode: " + op
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    pc := pc + 1
  }
  if pc < len(code) and err == "" and not returned {
    err := "instruction limit exceeded"
  }
  return map("environment", env, "output", output, "error", err, "returned", returned, "return_value", return_value)
}

define lowered_ir := lower_program(parsed_ast)
