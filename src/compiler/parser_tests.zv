# Resource-limit regressions: malicious plans must terminate instead of hanging or overflowing the host stack.
define recursive_source := "fn recurse(n) {\nreturn recurse(n + 1)\n}\nshow recurse(0)\n"
define recursive_lexed := lex(recursive_source)
define recursive_ast := parse_program(get(recursive_lexed, "tokens"))
define recursive_ir := lower_program(get(recursive_ast, "ast"))
define recursive_plan := emit_bytecode_plan(recursive_ir)
define recursive_result := execute_bytecode_plan(recursive_plan)
show get(recursive_result, "error")

# The runtime instruction cap is covered by Rust VM tests; do not burn the host test budget here.


# Generic source-to-plan driver. This is the reusable pipeline entry point for
# supported source text; it does not claim standalone bootstrap/self-hosting.


# Direct Bytecode v2 artifact regression for the Zenvora-written backend.
define generic_driver_v2 := compile_source("define answer := 40 + 2\nshow answer\n")
define generic_driver_v2_result := get(generic_driver_v2, "bytecode")
if get(generic_driver_v2, "ok") and get(generic_driver_v2_result, "ok") and index_of(get(generic_driver_v2_result, "artifact"), "ZENVORA_BYTECODE 2") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "PUSH 40") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "ADD") >= 0 and index_of(get(generic_driver_v2_result, "artifact"), "PRINT") >= 0 {
  show "ZENVORA_WRITTEN_BYTECODE_V2_MAIN_PASS"
} otherwise {
  show "ZENVORA_WRITTEN_BYTECODE_V2_MAIN_FAIL"
  show generic_driver_v2
  show generic_driver_v2_result
}

define generic_driver_v2_flow := compile_source("define i := 0\nrepeat i < 2 {\ni := i + 1\n}\nif i == 2 {\nshow 42\n} otherwise {\nshow 0\n}\n")
define generic_driver_v2_flow_result := get(generic_driver_v2_flow, "bytecode")
if get(generic_driver_v2_flow, "ok") and get(generic_driver_v2_flow_result, "ok") and index_of(get(generic_driver_v2_flow_result, "artifact"), "JUMP_IF_FALSE") >= 0 and index_of(get(generic_driver_v2_flow_result, "artifact"), "JUMP ") >= 0 {
  show "ZENVORA_WRITTEN_BYTECODE_V2_CONTROL_FLOW_PASS"
} otherwise {
  show "ZENVORA_WRITTEN_BYTECODE_V2_CONTROL_FLOW_FAIL"
  show generic_driver_v2_flow
  show generic_driver_v2_flow_result
}

# Regression: the same entry point compiles distinct caller-provided programs,
# and malformed source fails at the correct stage rather than emitting a plan.
define generic_driver_a := compile_source("define answer := 40 + 2\nshow answer\n")
define generic_driver_b := compile_source("fn double(n) {\nreturn n * 2\n}\nshow double(21)\n")
define generic_driver_bad := compile_source("show (1 +\n")
define generic_driver_run_a := execute_bytecode_plan(get(generic_driver_a, "plan"))
define generic_driver_run_b := execute_bytecode_plan(get(generic_driver_b, "plan"))
if get(generic_driver_a, "ok") and get(generic_driver_b, "ok") and not get(generic_driver_bad, "ok") and get(generic_driver_bad, "stage") == "parse" and get(get(generic_driver_run_a, "output"), 0) == "42" and get(get(generic_driver_run_b, "output"), 0) == "42" {
  show "ZENVORA_GENERIC_COMPILER_DRIVER_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_DRIVER_FAIL"
  show generic_driver_a
  show generic_driver_b
  show generic_driver_bad
}


# Broader generic-driver regressions: lexical errors, semantic errors, and control flow
# must be handled by the same caller-source pipeline (not by the fixed demo harness).
define generic_driver_if := compile_source("if 1 < 2 {\nshow 9\n} otherwise {\nshow 0\n}\n")
define generic_driver_lex_bad := compile_source("show @\n")
define generic_driver_semantic_bad := compile_source("show missing_value\n")
define generic_driver_if_run := execute_bytecode_plan(get(generic_driver_if, "plan"))
if get(generic_driver_if, "ok") and get(generic_driver_if_run, "ok") and get(get(generic_driver_if_run, "output"), 0) == "9" and not get(generic_driver_lex_bad, "ok") and get(generic_driver_lex_bad, "stage") == "lex" and not get(generic_driver_semantic_bad, "ok") and get(generic_driver_semantic_bad, "stage") == "validate" {
  show "ZENVORA_GENERIC_COMPILER_STAGES_PASS"
} otherwise {
  show "ZENVORA_GENERIC_COMPILER_STAGES_FAIL"
  show generic_driver_if
  show generic_driver_lex_bad
  show generic_driver_semantic_bad
}


# Additional generic-driver coverage for collections and loop lowering.
define generic_driver_loop := compile_source("define total := 0\ndefine items := array(2, 3, 4)\ndefine i := 0\nrepeat i < len(items) {\ntotal := total + get(items, i)\ni := i + 1\n}\nshow total\n")
define generic_driver_loop_run := execute_bytecode_plan(get(generic_driver_loop, "plan"))
