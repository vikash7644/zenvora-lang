# Basic functions are currently no-argument and return no value.
call greet()
call count_to_three(3)
show add(20, 22)

fn greet() {
    show 2026
}

fn count_to_three(limit) {
    define count := 0
    repeat count < limit {
        count := count + 1
        show count
    }
}

fn add(left, right) {
    return left + right
}
