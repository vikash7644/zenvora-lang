# Zenvora Lang language tour
# This file is executable with: zv examples/zenvora-language-tour.zv

define project := "Zenvora Lang"
define version := 8
define features := array("variables", "functions", "loops")

show "Welcome to " + project
show "Prototype milestone:"
show version
show "Feature count:"
show len(features)
show get(features, 0)

define score := 42
if score >= 40 {
    show "status: ready for the next test"
} otherwise {
    show "status: keep learning"
}

define sum := 0
define index := 1
repeat index <= 3 {
    sum := sum + index
    index := index + 1
}
show "sum 1..3:"
show sum
show "function result:"
show multiply(6, 7)

fn multiply(left, right) {
    return left * right
}
