# Zenvora-written compiler frontend, stage B0.
# Input contract: source tokens/operators must already be whitespace-separated.
# This is a bootstrap component, not yet a complete lexer.

fn tokenize_normalized(source) {
    define raw := split(trim(source), " ")
    define tokens := array()
    define index := 0

    repeat index < len(raw) {
        define token := get(raw, index)
        if token != "" {
            tokens := push(tokens, token)
        }
        index := index + 1
    }
    return tokens
}

fn token_kind(token) {
    if token == "define" {
        return "keyword"
    }
    if token == "show" {
        return "keyword"
    }
    if token == "fn" {
        return "keyword"
    }
    if token == "call" {
        return "keyword"
    }
    if token == "return" {
        return "keyword"
    }
    if token == "if" {
        return "keyword"
    }
    if token == "otherwise" {
        return "keyword"
    }
    if token == "repeat" {
        return "keyword"
    }
    if token == "true" or token == "false" {
        return "boolean"
    }
    if token == ":=" or token == "==" or token == "!=" or token == "<" or token == "<=" or token == ">" or token == ">=" {
        return "operator"
    }
    if token == "+" or token == "-" or token == "*" or token == "/" or token == "and" or token == "or" or token == "not" {
        return "operator"
    }
    if token == "(" or token == ")" or token == "[" or token == "]" or token == "{" or token == "}" or token == "," {
        return "punctuation"
    }
    return "atom"
}

fn classify_normalized(source) {
    define tokens := tokenize_normalized(source)
    define typed := array()
    define index := 0

    repeat index < len(tokens) {
        define token := get(tokens, index)
        typed := push(typed, token_kind(token))
        index := index + 1
    }
    return typed
}

# Smoke fixture: token order and token categories are deterministic.
define sample := "define answer := 40 + 2"
show tokenize_normalized(sample)
show classify_normalized(sample)
