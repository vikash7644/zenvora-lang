# QORVYNT self-hosting compiler kernel: frontend + plan verifier + native v2 serializer.
# Plan-VM regression harness is excluded to keep bootstrap execution bounded.

fn node(kind, value, left, right, line) {
  return map("kind", kind, "value", value, "left", left, "right", right, "line", line)
}

fn result(ast, pos, err) {
  return map("ast", ast, "pos", pos, "error", err)
}

fn at(tokens, pos) {
  return get(tokens, pos)
}

fn parse_primary(tokens, pos) {
  if pos >= len(tokens) {
    return result("", pos, "expected expression")
  }
  define t := at(tokens, pos)
  define kind := get(t, "kind")
  define value := get(t, "value")
  define ln := get(t, "line")
  if kind == "number" {
    return result(node("number", value, "", "", ln), pos + 1, "")
  } otherwise {
    if kind == "string" {
      return result(node("string", value, "", "", ln), pos + 1, "")
    } otherwise {
      if kind == "boolean" {
        return result(node("boolean", value, "", "", ln), pos + 1, "")
      } otherwise {
        if kind == "identifier" {
          return result(node("name", value, "", "", ln), pos + 1, "")
        } otherwise {
          if value == "(" {
            define nested := parse_expr(tokens, pos + 1)
            if get(nested, "error") != "" {
              return nested
            }
            define close_pos := get(nested, "pos")
            if close_pos >= len(tokens) or get(at(tokens, close_pos), "value") != ")" {
              return result("", close_pos, "expected closing parenthesis")
            }
            return result(get(nested, "ast"), close_pos + 1, "")
          } otherwise {
            return result("", pos, "expected literal, name, or parenthesized expression; got " + kind + " " + value + " at line " + to_string(ln) + " column " + to_string(get(t, "column")) )
          }
        }
      }
    }
  }
}

fn parse_postfix(tokens, pos) {
  define base_result := parse_primary(tokens, pos)
  if get(base_result, "error") != "" {
    return base_result
  }
  define base := get(base_result, "ast")
  define next := get(base_result, "pos")
  repeat next < len(tokens) and (get(at(tokens, next), "value") == "(" or get(at(tokens, next), "value") == "[") {
    define opener := get(at(tokens, next), "value")
    define ln := get(base, "line")
    if opener == "(" {
      define args := array()
      next := next + 1
      if next < len(tokens) and get(at(tokens, next), "value") != ")" {
        define arg_result := parse_expr(tokens, next)
        if get(arg_result, "error") != "" {
          return arg_result
        }
        args := push(args, get(arg_result, "ast"))
        next := get(arg_result, "pos")
        repeat next < len(tokens) and get(at(tokens, next), "value") == "," {
          next := next + 1
          define more_arg := parse_expr(tokens, next)
          if get(more_arg, "error") != "" {
            return more_arg
          }
          args := push(args, get(more_arg, "ast"))
          next := get(more_arg, "pos")
        }
      }
      if next >= len(tokens) or get(at(tokens, next), "value") != ")" {
        return result("", next, "expected closing parenthesis in call")
      }
      base := node("call", "", base, args, ln)
      next := next + 1
    } otherwise {
      next := next + 1
      define index_result := parse_expr(tokens, next)
      if get(index_result, "error") != "" {
        return index_result
      }
      next := get(index_result, "pos")
      if next >= len(tokens) or get(at(tokens, next), "value") != "]" {
        return result("", next, "expected closing bracket after index")
      }
      base := node("index", "", base, get(index_result, "ast"), ln)
      next := next + 1
    }
  }
  return result(base, next, "")
}

fn parse_unary_operand(tokens, pos, t, op) {
  define operand := parse_unary(tokens, pos + 1)
  if get(operand, "error") != "" {
    return operand
  }
  return result(node("unary", op, get(operand, "ast"), "", get(t, "line")), get(operand, "pos"), "")
}

fn parse_unary(tokens, pos) {
  if pos >= len(tokens) {
    return result("", pos, "expected expression")
  }
  define t := at(tokens, pos)
  define op := get(t, "value")
  define kind := get(t, "kind")
  if kind == "operator" {
    if op == "-" {
      return parse_unary_operand(tokens, pos, t, op)
    } otherwise {
      if op == "!" {
        return parse_unary_operand(tokens, pos, t, op)
      } otherwise {
        if op == "not" {
          return parse_unary_operand(tokens, pos, t, op)
        } otherwise {
          return parse_postfix(tokens, pos)
        }
      }
    }
  } otherwise {
    return parse_postfix(tokens, pos)
  }
}

fn parse_mul(tokens, pos) {
  define left_result := parse_unary(tokens, pos)
  if get(left_result, "error") != "" {
    return left_result
  }
  define left := get(left_result, "ast")
  define next := get(left_result, "pos")
  define ln := get(left, "line")
  repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "*" or get(at(tokens, next), "value") == "/") {
    define op := get(at(tokens, next), "value")
    define right_result := parse_unary(tokens, next + 1)
    if get(right_result, "error") != "" {
      return right_result
    }
    define right_ast := get(right_result, "ast")
    left := node("binary", op, left, right_ast, ln)
    next := get(right_result, "pos")
  }
  return result(left, next, "")
}

fn parse_add(tokens, pos) {
  define left_result := parse_mul(tokens, pos)
  if get(left_result, "error") != "" {
    return left_result
  }
  define left := get(left_result, "ast")
  define next := get(left_result, "pos")
  define ln := get(left, "line")
  repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "+" or get(at(tokens, next), "value") == "-") {
    define op := get(at(tokens, next), "value")
    define right_result := parse_mul(tokens, next + 1)
    if get(right_result, "error") != "" {
      return right_result
    }
    define right_ast := get(right_result, "ast")
    left := node("binary", op, left, right_ast, ln)
    next := get(right_result, "pos")
  }
  return result(left, next, "")
}

fn parse_compare(tokens, pos) {
  define left_result := parse_add(tokens, pos)
  if get(left_result, "error") != "" {
    return left_result
  }
  define left := get(left_result, "ast")
  define next := get(left_result, "pos")
  define ln := get(left, "line")
  repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "==" or get(at(tokens, next), "value") == "!=" or get(at(tokens, next), "value") == "<" or get(at(tokens, next), "value") == "<=" or get(at(tokens, next), "value") == ">" or get(at(tokens, next), "value") == ">=") {
    define op := get(at(tokens, next), "value")
    define right_result := parse_add(tokens, next + 1)
    if get(right_result, "error") != "" {
      return right_result
    }
    define right_ast := get(right_result, "ast")
    left := node("binary", op, left, right_ast, ln)
    next := get(right_result, "pos")
  }
  return result(left, next, "")
}

fn parse_and(tokens, pos) {
  define left_result := parse_compare(tokens, pos)
  if get(left_result, "error") != "" {
    return left_result
  }
  define left := get(left_result, "ast")
  define next := get(left_result, "pos")
  define ln := get(left, "line")
  repeat next < len(tokens) and get(at(tokens, next), "line") == ln and get(at(tokens, next), "value") == "and" {
    define op := get(at(tokens, next), "value")
    define right_result := parse_compare(tokens, next + 1)
    if get(right_result, "error") != "" {
      return right_result
    }
    left := node("binary", op, left, get(right_result, "ast"), ln)
    next := get(right_result, "pos")
  }
  return result(left, next, "")
}

fn parse_expr(tokens, pos) {
  define left_result := parse_and(tokens, pos)
  if get(left_result, "error") != "" {
    return left_result
  }
  define left := get(left_result, "ast")
  define next := get(left_result, "pos")
  define ln := get(left, "line")
  repeat next < len(tokens) and get(at(tokens, next), "line") == ln and get(at(tokens, next), "value") == "or" {
    define right_result := parse_and(tokens, next + 1)
    if get(right_result, "error") != "" {
      return right_result
    }
    left := node("binary", "or", left, get(right_result, "ast"), ln)
    next := get(right_result, "pos")
  }
  return result(left, next, "")
}

fn collect_tokens(tokens, start_pos, end_pos) {
  define out := array()
  define i := start_pos
  repeat i < end_pos {
    out := push(out, at(tokens, i))
    i := i + 1
  }
  return out
}

fn find_block_end(tokens, open_pos) {
  if open_pos >= len(tokens) or get(at(tokens, open_pos), "value") != "{" {
    return map("pos", open_pos, "error", "expected opening brace")
  }
  define depth := 1
  define pos := open_pos + 1
  repeat pos < len(tokens) and depth > 0 {
    define current_token := at(tokens, pos)
    define value := get(current_token, "value")
    # Braces inside string literals are data, not block delimiters.
    if get(current_token, "kind") == "punctuation" and value == "{" {
      depth := depth + 1
    } otherwise {
      if get(current_token, "kind") == "punctuation" and value == "}" {
        depth := depth - 1
      }
    }
    if depth > 0 {
      pos := pos + 1
    }
  }
  if depth != 0 {
    return map("pos", pos, "error", "expected closing brace")
  }
  return map("pos", pos, "error", "")
}

fn parse_program(tokens) {
  define ast := array()
  define pos := 0
  define err := ""
  repeat pos < len(tokens) and err == "" {
    define start := at(tokens, pos)
    define ln := get(start, "line")
    define kw := get(start, "value")
    if kw == "fn" {
      if pos + 2 >= len(tokens) or get(at(tokens, pos + 1), "kind") != "identifier" or get(at(tokens, pos + 2), "value") != "(" {
        err := "expected fn name(parameters)"
      } otherwise {
        define fn_name := get(at(tokens, pos + 1), "value")
        define params := array()
        define p := pos + 3
        define params_done := false
        repeat p < len(tokens) and not params_done and err == "" {
          if get(at(tokens, p), "value") == ")" {
            params_done := true
            p := p + 1
          } otherwise {
            if get(at(tokens, p), "kind") != "identifier" {
              err := "expected function parameter name"
            } otherwise {
              params := push(params, get(at(tokens, p), "value"))
              p := p + 1
              if p < len(tokens) and get(at(tokens, p), "value") == "," {
                p := p + 1
              } otherwise {
                if p < len(tokens) and get(at(tokens, p), "value") == ")" {
                  params_done := true
                  p := p + 1
                } otherwise {
                  err := "expected comma or closing parenthesis in parameters"
                }
              }
            }
          }
        }
        if err == "" and not params_done {
          err := "expected closing parenthesis in parameters"
        }
        if err == "" {
          define body_end := find_block_end(tokens, p)
          if get(body_end, "error") != "" {
            err := get(body_end, "error")
          } otherwise {
            define body_close := get(body_end, "pos")
            define fn_body_tokens := collect_tokens(tokens, p + 1, body_close)
            define fn_body_result := parse_program(fn_body_tokens)
            if get(fn_body_result, "error") != "" {
              err := get(fn_body_result, "error")
            } otherwise {
              ast := push(ast, node("function", fn_name, params, get(fn_body_result, "ast"), ln))
              pos := body_close + 1
            }
          }
        }
      }
    } otherwise {
      if kw == "if" or kw == "repeat" {
        define condition := parse_expr(tokens, pos + 1)
        if get(condition, "error") != "" {
          err := get(condition, "error")
        } otherwise {
          define open_pos := get(condition, "pos")
          define block_end := find_block_end(tokens, open_pos)
          if get(block_end, "error") != "" {
            err := get(block_end, "error")
          } otherwise {
            define close_pos := get(block_end, "pos")
            define body_tokens := collect_tokens(tokens, open_pos + 1, close_pos)
            define body_result := parse_program(body_tokens)
            if get(body_result, "error") != "" {
              err := get(body_result, "error")
            } otherwise {
              define body_ast := get(body_result, "ast")
              define else_ast := array()
              define next_pos := close_pos + 1
              if kw == "if" and next_pos < len(tokens) and get(at(tokens, next_pos), "value") == "otherwise" {
                define else_open := next_pos + 1
                define else_end := find_block_end(tokens, else_open)
                if get(else_end, "error") != "" {
                  err := get(else_end, "error")
                } otherwise {
                  define else_close := get(else_end, "pos")
                  define else_tokens := collect_tokens(tokens, else_open + 1, else_close)
                  define else_result := parse_program(else_tokens)
                  if get(else_result, "error") != "" {
                    err := get(else_result, "error")
                  } otherwise {
                    else_ast := get(else_result, "ast")
                    next_pos := else_close + 1
                  }
                }
              }
              if err == "" {
                if kw == "if" {
                  ast := push(ast, node("if", "", get(condition, "ast"), map("then", body_ast, "otherwise", else_ast), ln))
                } otherwise {
                  ast := push(ast, node("repeat", "", get(condition, "ast"), body_ast, ln))
                }
                pos := next_pos
              }
            }
          }
        }
      } otherwise {
        if kw == "return" {
          define expr := parse_expr(tokens, pos + 1)
          if get(expr, "error") != "" {
            err := get(expr, "error")
          } otherwise {
            if get(expr, "pos") == pos + 1 {
              err := "expected expression after return"
            } otherwise {
              ast := push(ast, node("return", "", get(expr, "ast"), "", ln))
              pos := get(expr, "pos")
            }
          }
        } otherwise {
          if kw == "break" or kw == "continue" {
            ast := push(ast, node(kw, "", "", "", ln))
            pos := pos + 1
          } otherwise {
            if kw == "define" {
              if pos + 2 >= len(tokens) {
                err := "incomplete define statement"
              } otherwise {
                define name_token := at(tokens, pos + 1)
                if get(name_token, "kind") != "identifier" or get(at(tokens, pos + 2), "value") != ":=" {
                  err := "expected define name := expression"
                } otherwise {
                  define expr := parse_expr(tokens, pos + 3)
                  if get(expr, "error") != "" {
                    err := get(expr, "error")
                  } otherwise {
                    if get(expr, "pos") == pos + 3 {
                      err := "expected expression after :="
                    } otherwise {
                      define name_value := get(name_token, "value")
                      define define_expr_ast := get(expr, "ast")
                      define define_statement_node := node("define", name_value, define_expr_ast, "", ln)
                      ast := push(ast, define_statement_node)
                      pos := get(expr, "pos")
                    }
                  }
                }
              }
            } otherwise {
              if kw == "show" {
                define expr := parse_expr(tokens, pos + 1)
                if get(expr, "error") != "" {
                  err := get(expr, "error")
                } otherwise {
                  if get(expr, "pos") == pos + 1 {
                    err := "expected expression after show"
                  } otherwise {
                    define show_expr_ast := get(expr, "ast")
                    define show_statement_node := node("show", "", show_expr_ast, "", ln)
                    ast := push(ast, show_statement_node)
                    pos := get(expr, "pos")
                  }
                }
              } otherwise {
                if get(start, "kind") == "identifier" and pos + 1 < len(tokens) and get(at(tokens, pos + 1), "value") == ":=" {
                  define expr := parse_expr(tokens, pos + 2)
                  if get(expr, "error") != "" {
                    err := get(expr, "error")
                  } otherwise {
                    define assignment_node := node("assign", get(start, "value"), get(expr, "ast"), "", ln)
                    ast := push(ast, assignment_node)
                    pos := get(expr, "pos")
                  }
                } otherwise {
                  err := "unsupported statement"
                }
              }
            }
          }
        }
      }
    }
    if pos < len(tokens) and get(at(tokens, pos), "line") == ln and err == "" {
      err := "unexpected token at end of statement"
    }
  }
  return map("ast", ast, "error", err)
}

fn space(c) {
  return c == " " or c == "\t" or c == "\n" or c == "\r"
}

fn letter(c) {
  return index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0
}

fn digit(c) {
  return index_of("0123456789", c) >= 0
}

fn word(c) {
  return letter(c) or digit(c)
}

fn token(k, v, l, c) {
  return map("kind", k, "value", v, "line", l, "column", c)
}

fn lex(source) {
  define out := array()
  define n := char_count(source)
  define i := 0
  define line := 1
  define col := 1
  define start_line := 1
  define start_col := 1
  define c := ""
  define d := ""
  define v := ""
  define k := ""
  define err := ""
  define closed := false
  repeat i < n and err == "" {
    c := char_at(source, i)
    if space(c) {
      if c == "\n" {
        line := line + 1
        col := 1
      } otherwise {
        col := col + 1
      }
      i := i + 1
    } otherwise {
      if c == "#" {
        repeat i < n and char_at(source, i) != "\n" {
          i := i + 1
          col := col + 1
        }
      } otherwise {
        start_line := line
        start_col := col
        v := ""
        if c == "\"" {
          k := "string"
          closed := false
          i := i + 1
          col := col + 1
          repeat i < n and not closed and err == "" {
            c := char_at(source, i)
            if c == "\"" {
              closed := true
              i := i + 1
              col := col + 1
            } otherwise {
              if c == "\\" {
                i := i + 1
                col := col + 1
                if i >= n {
                  err := "unterminated escape"
                } otherwise {
                  d := char_at(source, i)
                  if d == "n" {
                    v := v + "\n"
                  } otherwise {
                    if d == "t" {
                      v := v + "\t"
                    } otherwise {
                      if d == "r" {
                        v := v + "\r"
                      } otherwise {
                        if d == "\"" or d == "\\" {
                          v := v + d
                        } otherwise {
                          err := "unsupported escape"
                        }
                      }
                    }
                  }
                  i := i + 1
                  col := col + 1
                }
              } otherwise {
                if c == "\n" {
                  err := "newline in string literal"
                } otherwise {
                  v := v + c
                  i := i + 1
                  col := col + 1
                }
              }
            }
          }
          if err == "" and not closed {
            err := "unterminated string literal"
          }
          if err == "" {
            out := push(out, token(k, v, start_line, start_col))
          }
        } otherwise {
          if letter(c) {
            k := "identifier"
            repeat i < n and word(char_at(source, i)) {
              v := v + char_at(source, i)
              i := i + 1
              col := col + 1
            }
            if v == "define" or v == "show" or v == "fn" or v == "call" or v == "return" or v == "if" or v == "otherwise" or v == "repeat" or v == "break" or v == "continue" or v == "use" or v == "contract" or v == "state" or v == "action" or v == "view" {
              k := "keyword"
            } otherwise {
              if v == "true" or v == "false" {
                k := "boolean"
              } otherwise {
                if v == "and" or v == "or" or v == "not" {
                  k := "operator"
                }
              }
            }
            out := push(out, token(k, v, start_line, start_col))
          } otherwise {
            if digit(c) {
              k := "number"
              repeat i < n and digit(char_at(source, i)) {
                v := v + char_at(source, i)
                i := i + 1
                col := col + 1
              }
              out := push(out, token(k, v, start_line, start_col))
            } otherwise {
              d := ""
              if i + 1 < n {
                d := char_at(source, i + 1)
              }
              if (c == ":" and d == "=") or (c == "=" and d == "=") or (c == "!" and d == "=") or (c == "<" and d == "=") or (c == ">" and d == "=") {
                v := c + d
                k := "operator"
                i := i + 2
                col := col + 2
                out := push(out, token(k, v, start_line, start_col))
              } otherwise {
                v := c
                if c == "+" or c == "-" or c == "*" or c == "/" or c == "=" or c == "<" or c == ">" or c == "!" {
                  k := "operator"
                } otherwise {
                  if c == "(" or c == ")" or c == "[" or c == "]" or c == "{" or c == "}" or c == "," {
                    k := "punctuation"
                  } otherwise {
                    err := "unexpected character"
                  }
                }
                if err == "" {
                  out := push(out, token(k, v, start_line, start_col))
                  i := i + 1
                  col := col + 1
                }
              }
            }
          }
        }
      }
    }
  }
  return map("tokens", out, "error", err)
}

fn append_instructions(target, source) {
  define i := 0
  repeat i < len(source) {
    target := push(target, get(source, i))
    i := i + 1
  }
  return target
}

fn lower_expression(ast) {
  define out := array()
  define kind := get(ast, "kind")
  define value := get(ast, "value")
  if kind == "number" or kind == "string" or kind == "boolean" {
    out := push(out, map("op", "const", "value", value, "type", kind, "line", get(ast, "line")))
  } otherwise {
    if kind == "name" {
      out := push(out, map("op", "load", "name", value, "line", get(ast, "line")))
    } otherwise {
      if kind == "unary" {
        out := append_instructions(out, lower_expression(get(ast, "left")))
        out := push(out, map("op", "unary", "operator", value, "line", get(ast, "line")))
      } otherwise {
        if kind == "binary" {
          out := append_instructions(out, lower_expression(get(ast, "left")))
          out := append_instructions(out, lower_expression(get(ast, "right")))
          out := push(out, map("op", "binary", "operator", value, "line", get(ast, "line")))
        } otherwise {
          if kind == "index" {
            out := append_instructions(out, lower_expression(get(ast, "left")))
            out := append_instructions(out, lower_expression(get(ast, "right")))
            out := push(out, map("op", "index", "line", get(ast, "line")))
          } otherwise {
            if kind == "call" {
              define callee := get(ast, "left")
              define args := get(ast, "right")
              define argc := 0
              if get(callee, "kind") == "name" {
                define arg_pos := 0
                repeat arg_pos < len(args) {
                  out := append_instructions(out, lower_expression(get(args, arg_pos)))
                  argc := argc + 1
                  arg_pos := arg_pos + 1
                }
                out := push(out, map("op", "call", "name", get(callee, "value"), "argc", argc, "line", get(ast, "line")))
              } otherwise {
                out := append_instructions(out, lower_expression(callee))
                define arg_pos := 0
                repeat arg_pos < len(args) {
                  out := append_instructions(out, lower_expression(get(args, arg_pos)))
                  argc := argc + 1
                  arg_pos := arg_pos + 1
                }
                out := push(out, map("op", "call_indirect", "argc", argc, "line", get(ast, "line")))
              }
            } otherwise {
              out := push(out, map("op", "error", "message", "unsupported expression node", "kind", kind, "line", get(ast, "line")))
            }
          }
        }
      }
    }
  }
  return out
}

fn lower_program(ast) {
  define out := array()
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    define kind := get(statement, "kind")
    define value := get(statement, "value")
    define line := get(statement, "line")
    if kind == "define" {
      out := push(out, map("op", "declare", "name", value, "code", lower_expression(get(statement, "left")), "line", line))
    } otherwise {
      if kind == "assign" {
        out := push(out, map("op", "store", "name", value, "code", lower_expression(get(statement, "left")), "line", line))
      } otherwise {
        if kind == "show" {
          out := push(out, map("op", "print", "code", lower_expression(get(statement, "left")), "line", line))
        } otherwise {
          if kind == "return" {
            out := push(out, map("op", "return", "code", lower_expression(get(statement, "left")), "line", line))
          } otherwise {
            if kind == "if" {
              define branches := get(statement, "right")
              out := push(out, map("op", "branch", "condition", lower_expression(get(statement, "left")), "then", lower_program(get(branches, "then")), "otherwise", lower_program(get(branches, "otherwise")), "line", line))
            } otherwise {
              if kind == "repeat" {
                out := push(out, map("op", "loop", "condition", lower_expression(get(statement, "left")), "body", lower_program(get(statement, "right")), "line", line))
              } otherwise {
                if kind == "function" {
                  out := push(out, map("op", "function", "name", value, "parameters", get(statement, "left"), "body", lower_program(get(statement, "right")), "line", line))
                } otherwise {
                  if kind == "break" or kind == "continue" {
                    out := push(out, map("op", kind, "line", line))
                  } otherwise {
                    out := push(out, map("op", "error", "message", "unsupported statement node", "kind", kind, "line", line))
                  }
                }
              }
            }
          }
        }
      }
    }
    pos := pos + 1
  }
  return out
}

fn patch_jump(code, index, target) {
  define old_instruction := get(code, index)
  code[index] := put(old_instruction, "target", target)
  return code
}

fn emit_expression(code_ir) {
  define out := array()
  define pos := 0
  repeat pos < len(code_ir) {
    define item := get(code_ir, pos)
    define op := get(item, "op")
    if op == "const" {
      out := push(out, map("op", "push_const", "value", get(item, "value"), "type", get(item, "type"), "line", get(item, "line")))
    } otherwise {
      if op == "load" {
        out := push(out, map("op", "load", "name", get(item, "name"), "line", get(item, "line")))
      } otherwise {
        if op == "unary" {
          out := push(out, map("op", "unary", "operator", get(item, "operator"), "line", get(item, "line")))
        } otherwise {
          if op == "binary" {
            out := push(out, map("op", "binary", "operator", get(item, "operator"), "line", get(item, "line")))
          } otherwise {
            if op == "index" {
              out := push(out, map("op", "index", "line", get(item, "line")))
            } otherwise {
              if op == "call" {
                out := push(out, map("op", "call", "name", get(item, "name"), "argc", get(item, "argc"), "line", get(item, "line")))
              } otherwise {
                out := push(out, map("op", "compile_error", "message", "unsupported expression IR", "kind", op, "line", get(item, "line")))
              }
            }
          }
        }
      }
    }
    pos := pos + 1
  }
  return out
}

fn statements_terminate(ir) {
  if len(ir) == 0 {
    return false
  }
  define last := get(ir, len(ir) - 1)
  define op := get(last, "op")
  if op == "return" {
    return true
  }
  if op == "branch" {
    define then_code := get(last, "then")
    define otherwise_code := get(last, "otherwise")
    return len(otherwise_code) > 0 and statements_terminate(then_code) and statements_terminate(otherwise_code)
  }
  return false
}

fn emit_statements(ir) {
  define out := array()
  define pos := 0
  repeat pos < len(ir) {
    define item := get(ir, pos)
    define op := get(item, "op")
    define line := get(item, "line")
    if op == "declare" or op == "store" or op == "print" or op == "return" {
      out := append_instructions(out, emit_expression(get(item, "code")))
      if op == "declare" {
        out := push(out, map("op", "declare", "name", get(item, "name"), "line", line))
      } otherwise {
        if op == "store" {
          out := push(out, map("op", "store", "name", get(item, "name"), "line", line))
        } otherwise {
          if op == "print" {
            out := push(out, map("op", "print", "line", line))
          } otherwise {
            out := push(out, map("op", "return", "has_value", len(get(item, "code")) > 0, "line", line))
          }
        }
      }
    } otherwise {
      if op == "branch" {
        out := append_instructions(out, emit_expression(get(item, "condition")))
        define false_jump := len(out)
        out := push(out, map("op", "jump_if_false", "target", -1, "line", line))
        out := append_instructions(out, emit_statements(get(item, "then")))
        define otherwise_code := get(item, "otherwise")
        if len(otherwise_code) > 0 {
          if statements_terminate(get(item, "then")) {
            out := patch_jump(out, false_jump, len(out))
            out := append_instructions(out, emit_statements(otherwise_code))
          } otherwise {
            define end_jump := len(out)
            out := push(out, map("op", "jump", "target", -1, "line", line))
            out := patch_jump(out, false_jump, len(out))
            out := append_instructions(out, emit_statements(otherwise_code))
            out := patch_jump(out, end_jump, len(out))
          }
        } otherwise {
          out := patch_jump(out, false_jump, len(out))
        }
      } otherwise {
        if op == "loop" {
          define loop_start := len(out)
          out := append_instructions(out, emit_expression(get(item, "condition")))
          define exit_jump := len(out)
          out := push(out, map("op", "jump_if_false", "target", -1, "line", line))
          define body_start := len(out)
          out := append_instructions(out, emit_statements(get(item, "body")))
          out := push(out, map("op", "jump", "target", loop_start, "line", line))
          define loop_end := len(out)
          out := patch_jump(out, exit_jump, loop_end)
          define scan := body_start
          repeat scan < loop_end {
            define candidate := get(out, scan)
            if get(candidate, "op") == "break" {
              out[scan] := map("op", "jump", "target", loop_end, "line", get(candidate, "line"))
            } otherwise {
              if get(candidate, "op") == "continue" {
                out[scan] := map("op", "jump", "target", loop_start, "line", get(candidate, "line"))
              }
            }
            scan := scan + 1
          }
        } otherwise {
          if op == "break" or op == "continue" {
            out := push(out, map("op", op, "line", line))
          } otherwise {
            if op == "function" {
              out := push(out, map("op", "nested_function", "name", get(item, "name"), "line", line))
            } otherwise {
              out := push(out, map("op", "compile_error", "message", "unsupported statement IR", "kind", op, "line", line))
            }
          }
        }
      }
    }
    pos := pos + 1
  }
  return out
}

fn json_quote(value) {
  define escaped := replace(value, "\\", "\\\\")
  escaped := replace(escaped, "\"", "\\\"")
  escaped := replace(escaped, "\n", "\\n")
  escaped := replace(escaped, "\r", "\\r")
  escaped := replace(escaped, "\t", "\\t")
  return "\"" + escaped + "\""
}

fn json_encode(value) {
  define kind := type_of(value)
  if kind == "string" {
    return json_quote(value)
  }
  if kind == "integer" or kind == "boolean" {
    return to_string(value)
  }
  if kind == "array" {
    define parts := array()
    define pos := 0
    repeat pos < len(value) {
      parts := push(parts, json_encode(get(value, pos)))
      pos := pos + 1
    }
    return "[" + join(parts, ",") + "]"
  }
  if kind == "map" {
    define parts := array()
    define map_keys := keys(value)
    define pos := 0
    repeat pos < len(map_keys) {
      define key := get(map_keys, pos)
      parts := push(parts, json_quote(key) + ":" + json_encode(get(value, key)))
      pos := pos + 1
    }
    return "{" + join(parts, ",") + "}"
  }
  return "null"
}

fn emit_bytecode_plan(ir) {
  define main_ir := array()
  define functions := array()
  define pos := 0
  repeat pos < len(ir) {
    define item := get(ir, pos)
    if get(item, "op") == "function" {
      define function_code := emit_statements(get(item, "body"))
      functions := push(functions, map("name", get(item, "name"), "parameters", get(item, "parameters"), "code", function_code, "falls_through", not statements_terminate(get(item, "body")), "line", get(item, "line")))
    } otherwise {
      main_ir := push(main_ir, item)
    }
    pos := pos + 1
  }
  # Emit the complete main program in one pass so jump targets are absolute
  # within the main instruction stream, rather than restarting at zero for
  # every top-level statement.
  define main := emit_statements(main_ir)
  return map("format", "ZENVORA_BYTECODE_PLAN_1", "main", main, "functions", functions)
}

fn find_plan_function_entry(entries, name) {
  define pos := 0
  repeat pos < len(entries) {
    define entry := get(entries, pos)
    if get(entry, "name") == name {
      return get(entry, "entry")
    }
    pos := pos + 1
  }
  return -1
}

fn find_plan_function_layout(entries, name) {
  define pos := 0
  repeat pos < len(entries) {
    define entry := get(entries, pos)
    if get(entry, "name") == name {
      return entry
    }
    pos := pos + 1
  }
  return map()
}

fn plan_code_has_return(code, has_value) {
  define pos := 0
  repeat pos < len(code) {
    define item := get(code, pos)
    if get(item, "op") == "return" and get(item, "has_value") == has_value {
      return true
    }
    pos := pos + 1
  }
  return false
}

fn binary_v2_opcode(operator) {
  define opcodes := map("+", "ADD", "-", "SUB", "*", "MUL", "/", "DIV", "==", "EQ", "!=", "NE", "<", "LT", "<=", "LE", ">", "GT", ">=", "GE", "and", "AND", "or", "OR")
  if contains(opcodes, operator) {
    return get(opcodes, operator)
  }
  return ""
}

fn emit_v2_instruction(item, base, entries) {
  define op := get(item, "op")
  if op == "push_const" {
    define kind := get(item, "type")
    if kind == "number" {
      return "PUSH " + to_string(get(item, "value"))
    } otherwise {
      if kind == "boolean" {
        return "PUSH_BOOL " + to_string(get(item, "value"))
      } otherwise {
        if kind == "string" {
          return "PUSH_STRING_HEX " + hex_encode(get(item, "value"))
        }
      }
    }
  } otherwise {
    if op == "load" or op == "declare" or op == "store" {
      if op == "load" {
        return "LOAD " + get(item, "name")
      } otherwise {
        if op == "declare" {
          return "DECLARE " + get(item, "name")
        } otherwise {
          return "STORE " + get(item, "name")
        }
      }
    } otherwise {
      if op == "unary" {
        define operator := get(item, "operator")
        if operator == "-" {
          return "NEG"
        } otherwise {
          if operator == "!" or operator == "not" {
            return "NOT"
          }
        }
      } otherwise {
        if op == "binary" {
          define opcode := binary_v2_opcode(get(item, "operator"))
          if opcode != "" {
            return opcode
          }
        } otherwise {
          if op == "index" {
            return "INDEX"
          } otherwise {
            if op == "print" {
              return "PRINT"
            } otherwise {
              if op == "return" {
                if get(item, "has_value") {
                  return "RETURN_VALUE"
                } otherwise {
                  return "RETURN"
                }
              } otherwise {
                if op == "jump" {
                  return "JUMP " + to_string(base + get(item, "target"))
                } otherwise {
                  if op == "jump_if_false" {
                    return "JUMP_IF_FALSE " + to_string(base + get(item, "target"))
                  } otherwise {
                    if op == "call" {
                      define name := get(item, "name")
                      define argc := get(item, "argc")
                      if is_builtin_function(name) {
                        return "BUILTIN " + name + " " + to_string(argc)
                      } otherwise {
                        define entry := find_plan_function_entry(entries, name)
                        if entry >= 0 {
                          return "CALL " + to_string(entry) + " " + to_string(argc)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return ""
}

fn emit_v2_code(code, base, entries) {
  define lines := array()
  define pos := 0
  repeat pos < len(code) {
    define line := emit_v2_instruction(get(code, pos), base, entries)
    if line == "" {
      return map("ok", false, "lines", array(), "error", "unsupported plan instruction at index " + to_string(pos))
    }
    lines := push(lines, line)
    pos := pos + 1
  }
  return map("ok", true, "lines", lines, "error", "")
}

fn emit_bytecode_v2(plan) {
  if get(plan, "format") != "ZENVORA_BYTECODE_PLAN_1" {
    return map("ok", false, "bytecode", "", "error", "unsupported bytecode plan format")
  }
  define main := get(plan, "main")
  define functions := get(plan, "functions")
  define main_end := len(main) + 1
  define entries := array()
  define cursor := main_end
  define pos := 0
  repeat pos < len(functions) {
    define function_item := get(functions, pos)
    define fn_name := get(function_item, "name")
    define fn_code := get(function_item, "code")
    define fn_size := len(fn_code)
    if get(function_item, "falls_through") {
      fn_size := fn_size + 1
    }
    entries := push(entries, map("name", fn_name, "entry", cursor, "end", cursor + fn_size))
    cursor := cursor + fn_size
    pos := pos + 1
  }

  define main_result := emit_v2_code(main, 0, entries)
  if not get(main_result, "ok") {
    return map("ok", false, "bytecode", "", "error", get(main_result, "error"))
  }
  define instruction_lines := get(main_result, "lines")
  instruction_lines := push(instruction_lines, "JUMP " + to_string(main_end))
  define metadata_lines := array()

  pos := 0
  repeat pos < len(functions) {
    define function_item := get(functions, pos)
    define fn_name := get(function_item, "name")
    define fn_code := get(function_item, "code")
    define layout := find_plan_function_layout(entries, fn_name)
    define entry := get(layout, "entry")
    define fn_end := get(layout, "end")
    define params := get(function_item, "parameters")
    define has_value_return := plan_code_has_return(fn_code, true)
    define has_void_return := plan_code_has_return(fn_code, false)
    if has_value_return and has_void_return {
      return map("ok", false, "bytecode", "", "error", "function mixes value and void returns: " + fn_name)
    }
    if has_value_return and get(function_item, "falls_through") {
      return map("ok", false, "bytecode", "", "error", "function may fall through without a value: " + fn_name)
    }
    define return_kind := "void"
    if has_value_return {
      return_kind := "value"
    }
    define parameter_text := "-"
    if len(params) > 0 {
      parameter_text := join(params, " ")
    }
    metadata_lines := push(metadata_lines, "FUNCTION " + to_string(entry) + " " + to_string(fn_end) + " " + to_string(len(params)) + " " + return_kind + " " + parameter_text)
    define fn_result := emit_v2_code(fn_code, entry, entries)
    if not get(fn_result, "ok") {
      return map("ok", false, "bytecode", "", "error", "function " + fn_name + ": " + get(fn_result, "error"))
    }
    instruction_lines := append_instructions(instruction_lines, get(fn_result, "lines"))
    if get(function_item, "falls_through") {
      instruction_lines := push(instruction_lines, "RETURN")
    }
    pos := pos + 1
  }

  define metadata_text := ""
  if len(metadata_lines) > 0 {
    metadata_text := join(metadata_lines, "\n") + "\n"
  }
  define bytecode := "ZENVORA_BYTECODE 2\nPROGRAM 0 " + to_string(main_end) + "\n" + metadata_text + "CODE\n" + join(instruction_lines, "\n") + "\n"
  return map("ok", true, "bytecode", bytecode, "error", "")
}

fn validate_expression(ast) {
  define kind := get(ast, "kind")
  if kind == "number" or kind == "string" or kind == "boolean" or kind == "name" {
    return ""
  } otherwise {
    if kind == "unary" {
      return validate_expression(get(ast, "left"))
    } otherwise {
      if kind == "binary" or kind == "index" {
        define left_error := validate_expression(get(ast, "left"))
        if left_error != "" {
          return left_error
        }
        return validate_expression(get(ast, "right"))
      } otherwise {
        if kind == "call" {
          define callee_error := validate_expression(get(ast, "left"))
          if callee_error != "" {
            return callee_error
          }
          define args := get(ast, "right")
          define pos := 0
          repeat pos < len(args) {
            define arg_error := validate_expression(get(args, pos))
            if arg_error != "" {
              return arg_error
            }
            pos := pos + 1
          }
          return ""
        } otherwise {
          return "unsupported expression node: " + kind
        }
      }
    }
  }
}

fn validate_statements(ast, function_depth, loop_depth) {
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    define kind := get(statement, "kind")
    define expression_error := ""
    if kind == "define" or kind == "assign" or kind == "show" {
      expression_error := validate_expression(get(statement, "left"))
    } otherwise {
      if kind == "if" {
        expression_error := validate_expression(get(statement, "left"))
        if expression_error == "" {
          define branches := get(statement, "right")
          expression_error := validate_statements(get(branches, "then"), function_depth, loop_depth)
          if expression_error == "" {
            expression_error := validate_statements(get(branches, "otherwise"), function_depth, loop_depth)
          }
        }
      } otherwise {
        if kind == "repeat" {
          expression_error := validate_expression(get(statement, "left"))
          if expression_error == "" {
            expression_error := validate_statements(get(statement, "right"), function_depth, loop_depth + 1)
          }
        } otherwise {
          if kind == "function" {
            if function_depth > 0 {
              expression_error := "nested function declarations are not supported"
            }
            define params := get(statement, "left")
            define param_pos := 0
            repeat param_pos < len(params) and expression_error == "" {
              define param := get(params, param_pos)
              define prior := 0
              repeat prior < param_pos and expression_error == "" {
                if get(params, prior) == param {
                  expression_error := "duplicate function parameter: " + param
                }
                prior := prior + 1
              }
              param_pos := param_pos + 1
            }
            if expression_error == "" {
              expression_error := validate_statements(get(statement, "right"), function_depth + 1, 0)
            }
          } otherwise {
            if kind == "return" {
              if function_depth == 0 {
                expression_error := "return outside function"
              } otherwise {
                expression_error := validate_expression(get(statement, "left"))
              }
            } otherwise {
              if kind == "break" or kind == "continue" {
                if loop_depth == 0 {
                  expression_error := kind + " outside loop"
                }
              } otherwise {
                expression_error := "unsupported statement node: " + kind
              }
            }
          }
        }
      }
    }
    if expression_error != "" {
      return expression_error
    }
    pos := pos + 1
  }
  return ""
}

fn is_builtin_function(name) {
  return name == "array" or name == "map" or name == "get" or name == "hex_encode" or name == "len" or name == "contains" or name == "push" or name == "put" or name == "keys" or name == "values" or name == "char_at" or name == "type_of" or name == "to_string" or name == "abs" or name == "min" or name == "max" or name == "range" or name == "assert" or name == "sum" or name == "first" or name == "last" or name == "reverse" or name == "is_empty" or name == "clamp" or name == "starts_with" or name == "ends_with" or name == "replace" or name == "split" or name == "join" or name == "trim" or name == "lower" or name == "upper" or name == "char_count" or name == "to_int" or name == "index_of" or name == "unique" or name == "assert_eq" or name == "gcd" or name == "lcm" or name == "factorial" or name == "is_prime" or name == "fibonacci" or name == "pow_int" or name == "mean" or name == "speed" or name == "force" or name == "kinetic_energy" or name == "density" or name == "molarity" or name == "bmi_x10" or name == "molar_mass" or name == "dna_complement" or name == "gc_content_percent"
}

fn builtin_fixed_arity(name) {
  if name == "hex_encode" or name == "len" or name == "keys" or name == "values" or name == "type_of" or name == "to_string" or name == "abs" or name == "first" or name == "last" or name == "reverse" or name == "is_empty" or name == "trim" or name == "lower" or name == "upper" or name == "char_count" or name == "to_int" or name == "unique" or name == "assert" or name == "factorial" or name == "is_prime" or name == "fibonacci" or name == "mean" or name == "molar_mass" or name == "sum" or name == "dna_complement" or name == "gc_content_percent" {
    return 1
  }
  if name == "get" or name == "contains" or name == "push" or name == "min" or name == "max" or name == "starts_with" or name == "ends_with" or name == "split" or name == "join" or name == "char_at" or name == "index_of" or name == "assert_eq" or name == "gcd" or name == "lcm" or name == "pow_int" or name == "speed" or name == "density" or name == "molarity" or name == "force" or name == "kinetic_energy" or name == "bmi_x10" {
    return 2
  }
  if name == "put" or name == "replace" or name == "clamp" {
    return 3
  }
  return -1
}

fn validate_call_expression(ast, functions) {
  define kind := get(ast, "kind")
  if kind == "call" {
    define callee := get(ast, "left")
    if get(callee, "kind") != "name" {
      return "indirect function calls are not supported"
    }
    define name := get(callee, "value")
    define args := get(ast, "right")
    define found := false
    define pos := 0
    repeat pos < len(functions) and not found {
      define signature := get(functions, pos)
      if get(signature, "name") == name {
        found := true
        if len(get(signature, "parameters")) != len(args) {
          return "function argument count mismatch: " + name
        }
      }
      pos := pos + 1
    }
    if not found and not is_builtin_function(name) {
      return "undefined function: " + name
    }
    if not found {
      define expected_arity := builtin_fixed_arity(name)
      if expected_arity >= 0 and len(args) != expected_arity {
        return "built-in argument count mismatch: " + name
      }
    }
    define arg_pos := 0
    repeat arg_pos < len(args) {
      define arg_error := validate_call_expression(get(args, arg_pos), functions)
      if arg_error != "" {
        return arg_error
      }
      arg_pos := arg_pos + 1
    }
    return ""
  } otherwise {
    if kind == "unary" {
      return validate_call_expression(get(ast, "left"), functions)
    } otherwise {
      if kind == "binary" or kind == "index" {
        define left_error := validate_call_expression(get(ast, "left"), functions)
        if left_error != "" {
          return left_error
        }
        return validate_call_expression(get(ast, "right"), functions)
      }
    }
  }
  return ""
}

fn validate_call_statements(ast, functions) {
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    define kind := get(statement, "kind")
    define err := ""
    if kind == "define" or kind == "assign" or kind == "show" or kind == "return" {
      err := validate_call_expression(get(statement, "left"), functions)
    } otherwise {
      if kind == "if" {
        err := validate_call_expression(get(statement, "left"), functions)
        if err == "" {
          define branches := get(statement, "right")
          err := validate_call_statements(get(branches, "then"), functions)
          if err == "" {
            err := validate_call_statements(get(branches, "otherwise"), functions)
          }
        }
      } otherwise {
        if kind == "repeat" {
          err := validate_call_expression(get(statement, "left"), functions)
          if err == "" {
            err := validate_call_statements(get(statement, "right"), functions)
          }
        } otherwise {
          if kind == "function" {
            err := validate_call_statements(get(statement, "right"), functions)
          }
        }
      }
    }
    if err != "" {
      return err
    }
    pos := pos + 1
  }
  return ""
}

fn collect_scope_names(ast, names) {
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    define kind := get(statement, "kind")
    if kind == "define" {
      define name := get(statement, "value")
      if not contains(names, name) {
        names := push(names, name)
      }
    } otherwise {
      if kind == "if" {
        define branches := get(statement, "right")
        names := collect_scope_names(get(branches, "then"), names)
        names := collect_scope_names(get(branches, "otherwise"), names)
      } otherwise {
        if kind == "repeat" {
          names := collect_scope_names(get(statement, "right"), names)
        }
      }
    }
    pos := pos + 1
  }
  return names
}

fn validate_variable_expression(ast, names) {
  define kind := get(ast, "kind")
  if kind == "name" {
    define name := get(ast, "value")
    if contains(names, name) {
      return ""
    }
    return "undefined variable: " + name
  } otherwise {
    if kind == "number" or kind == "string" or kind == "boolean" {
      return ""
    } otherwise {
      if kind == "unary" {
        return validate_variable_expression(get(ast, "left"), names)
      } otherwise {
        if kind == "binary" or kind == "index" {
          define left_error := validate_variable_expression(get(ast, "left"), names)
          if left_error != "" {
            return left_error
          }
          return validate_variable_expression(get(ast, "right"), names)
        } otherwise {
          if kind == "call" {
            define args := get(ast, "right")
            define pos := 0
            repeat pos < len(args) {
              define arg_error := validate_variable_expression(get(args, pos), names)
              if arg_error != "" {
                return arg_error
              }
              pos := pos + 1
            }
            return ""
          }
        }
      }
    }
  }
  return ""
}

fn validate_variable_statements(ast, names) {
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    define kind := get(statement, "kind")
    define err := ""
    if kind == "define" or kind == "show" or kind == "return" {
      err := validate_variable_expression(get(statement, "left"), names)
    } otherwise {
      if kind == "assign" {
        err := validate_variable_expression(get(statement, "left"), names)
        if err == "" {
          define target := get(statement, "value")
          if not contains(names, target) {
            err := "assignment to undefined variable: " + target
          }
        }
      } otherwise {
        if kind == "if" {
          err := validate_variable_expression(get(statement, "left"), names)
          if err == "" {
            define branches := get(statement, "right")
            err := validate_variable_statements(get(branches, "then"), names)
            if err == "" {
              err := validate_variable_statements(get(branches, "otherwise"), names)
            }
          }
        } otherwise {
          if kind == "repeat" {
            err := validate_variable_expression(get(statement, "left"), names)
            if err == "" {
              err := validate_variable_statements(get(statement, "right"), names)
            }
          } otherwise {
            if kind == "function" {
              define local_names := names
              define params := get(statement, "left")
              define param_pos := 0
              repeat param_pos < len(params) {
                define param := get(params, param_pos)
                if not contains(local_names, param) {
                  local_names := push(local_names, param)
                }
                param_pos := param_pos + 1
              }
              local_names := collect_scope_names(get(statement, "right"), local_names)
              err := validate_variable_statements(get(statement, "right"), local_names)
            }
          }
        }
      }
    }
    if err != "" {
      return err
    }
    pos := pos + 1
  }
  return ""
}

fn validate_program(ast) {
  define seen_functions := array()
  define function_signatures := array()
  define pos := 0
  repeat pos < len(ast) {
    define statement := get(ast, pos)
    if get(statement, "kind") == "function" {
      define name := get(statement, "value")
      if contains(seen_functions, name) {
        return map("ok", false, "error", "duplicate function: " + name)
      }
      seen_functions := push(seen_functions, name)
      function_signatures := push(function_signatures, map("name", name, "parameters", get(statement, "left")))
    }
    pos := pos + 1
  }
  define call_error := validate_call_statements(ast, function_signatures)
  if call_error != "" {
    return map("ok", false, "error", call_error)
  }
  define error := validate_statements(ast, 0, 0)
  if error == "" {
    # source_text is the host-injected input binding used by the compiler driver.
    define visible_names := collect_scope_names(ast, array("source_text"))
    error := validate_variable_statements(ast, visible_names)
  }
  return map("ok", error == "", "error", error)
}

fn is_allowed_opcode(op) {
  define allowed := array("push_const", "load", "unary", "binary", "index", "call", "declare", "store", "print", "return", "jump_if_false", "jump", "break", "continue")
  define pos := 0
  repeat pos < len(allowed) {
    if get(allowed, pos) == op {
      return true
    }
    pos := pos + 1
  }
  return false
}

fn verify_code(code) {
  define pos := 0
  repeat pos < len(code) {
    define instruction := get(code, pos)
    if type_of(instruction) != "map" {
      return "malformed instruction record"
    }
    define op := get(instruction, "op")
    if not is_allowed_opcode(op) {
      return "unsupported bytecode opcode: " + op
    }
    if op == "jump" or op == "jump_if_false" {
      define target := get(instruction, "target")
      if type_of(target) != "integer" or target < 0 or target > len(code) {
        return "invalid jump target"
      }
    }
    pos := pos + 1
  }
  return ""
}

fn verify_bytecode_plan(plan) {
  if get(plan, "format") != "ZENVORA_BYTECODE_PLAN_1" {
    return map("ok", false, "error", "unknown bytecode plan format")
  }
  define main_error := verify_code(get(plan, "main"))
  if main_error != "" {
    return map("ok", false, "error", "main: " + main_error)
  }
  define functions := get(plan, "functions")
  define pos := 0
  repeat pos < len(functions) {
    define fn_record := get(functions, pos)
    define fn_error := verify_code(get(fn_record, "code"))
    if fn_error != "" {
      return map("ok", false, "error", "function " + get(fn_record, "name") + ": " + fn_error)
    }
    pos := pos + 1
  }
  return map("ok", true, "error", "")
}

fn compile_source(source) {
  define lexed := lex(source)
  if get(lexed, "error") != "" {
    return map("ok", false, "stage", "lex", "error", get(lexed, "error"), "plan", "")
  }
  define parsed := parse_program(get(lexed, "tokens"))
  if get(parsed, "error") != "" {
    return map("ok", false, "stage", "parse", "error", get(parsed, "error"), "plan", "")
  }
  define semantic := validate_program(get(parsed, "ast"))
  if not get(semantic, "ok") {
    return map("ok", false, "stage", "validate", "error", get(semantic, "error"), "plan", "")
  }
  define ir := lower_program(get(parsed, "ast"))
  define plan := emit_bytecode_plan(ir)
  define verified := verify_bytecode_plan(plan)
  if not get(verified, "ok") {
    return map("ok", false, "stage", "verify", "error", get(verified, "error"), "plan", "")
  }
  return map("ok", true, "stage", "complete", "error", "", "plan", plan)
}

# Minimal self-hosting compiler kernel. The host injects source_text.
define input_compile_result := compile_source(source_text)
if get(input_compile_result, "ok") {
  define input_native_v2 := emit_bytecode_v2(get(input_compile_result, "plan"))
  if get(input_native_v2, "ok") {
    show "ZENVORA_INPUT_BYTECODE_V2_JSON"
    show json_encode(get(input_native_v2, "bytecode"))
  } otherwise {
    show "ZENVORA_INPUT_BYTECODE_V2_FAIL"
    show get(input_native_v2, "error")
  }
} otherwise {
  show "ZENVORA_INPUT_BYTECODE_V2_FAIL"
  show input_compile_result
}
