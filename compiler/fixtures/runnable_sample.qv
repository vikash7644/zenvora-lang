define answer := 2 + 3 * 4
show answer
fn add(a, b) {
return a + b
}
show add(20, 22)
fn choose(a, b) {
if a > 0 {
return add(a, b)
} otherwise {
return b
}
}
show choose(2, 5)
show choose(0, 7)
fn factorial(n) {
if n <= 1 {
return 1
} otherwise {
return n * factorial(n - 1)
}
}
show factorial(5)
show sum(array(3, 4))
show len(array(1, 2, 3))
show char_at("zv", 1)
show starts_with("zenvora", "zen")
show upper("zv")
show char_count("zv")
show index_of("zenvora", "v")
show contains(array(1, 2, 3), 2)
show get(map("answer", 42), "answer")
define pushed_values := push(array(1), 2)
show len(pushed_values)
show replace("zv", "z", "x")
define split_values := split("a,b", ",")
show len(split_values)
show clamp(9, 0, 5)
define unique_values := unique(array(1, 1, 2))
show len(unique_values)
show to_int("42")
define range_values := range(0, 3)
show len(range_values)
show factorial(6)
show fibonacci(10)
show pow_int(2, 8)
show mean(array(3, 6, 9))
show speed(100, 4)
show force(3, 7)
show kinetic_energy(4, 3)
show bmi_x10(70, 175)
show molar_mass(array(12, 16, 1))
show "-"
show "!"
show "not"
