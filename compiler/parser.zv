# Zenvora-written recursive-descent parser foundation.
# Current supported statements: define name := expression; show expression.
# Expressions: literals, names, parentheses, *, /, +, -, comparisons, and/or.
fn node(kind, value, left, right, line) {
 return map("kind", kind, "value", value, "left", left, "right", right, "line", line)
}
fn result(ast, pos, err) {
 return map("ast", ast, "pos", pos, "error", err)
}
fn at(tokens, pos) {
 return get(tokens, pos)
}
fn val(tokens, pos) {
 return get(at(tokens, pos), "value")
}
fn line_at(tokens, pos) {
 return get(at(tokens, pos), "line")
}
fn parse_primary(tokens, pos) {
 if pos >= len(tokens) {
  return result("", pos, "expected expression")
 }
 define t := at(tokens, pos)
 define k := get(t, "kind")
 define v := get(t, "value")
 define ln := get(t, "line")
 if k == "number" {
  return result(node("integer", v, "", "", ln), pos + 1, "")
 }
 if k == "string" {
  return result(node("string", v, "", "", ln), pos + 1, "")
 }
 if k == "boolean" {
  return result(node("boolean", v, "", "", ln), pos + 1, "")
 }
 if k == "identifier" {
  return result(node("name", v, "", "", ln), pos + 1, "")
 }
 if v == "(" {
  define inner := parse_expr(tokens, pos + 1)
  if get(inner, "error") != "" {
   return inner
  }
  define after := get(inner, "pos")
  if after >= len(tokens) or val(tokens, after) != ")" {
   return result("", after, "expected closing parenthesis")
  }
  return result(get(inner, "ast"), after + 1, "")
 }
 return result("", pos, "expected expression")
}

fn parse_mul(tokens, pos) {
 define left_result := parse_primary(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and line_at(tokens, next) == ln and (val(tokens, next) == "*" or val(tokens, next) == "/") {
  define op := val(tokens, next)
  define right_result := parse_primary(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  left := node("binary", op, left, get(right_result, "ast"), ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_add(tokens, pos) {
 define left_result := parse_mul(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and line_at(tokens, next) == ln and (val(tokens, next) == "+" or val(tokens, next) == "-") {
  define op := val(tokens, next)
  define right_result := parse_mul(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  left := node("binary", op, left, get(right_result, "ast"), ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_compare(tokens, pos) {
 define left_result := parse_add(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and line_at(tokens, next) == ln and (val(tokens, next) == "==" or val(tokens, next) == "!=" or val(tokens, next) == "<" or val(tokens, next) == "<=" or val(tokens, next) == ">" or val(tokens, next) == ">=") {
  define op := val(tokens, next)
  define right_result := parse_add(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  left := node("binary", op, left, get(right_result, "ast"), ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_expr(tokens, pos) {
 define left_result := parse_compare(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and line_at(tokens, next) == ln and (val(tokens, next) == "and" or val(tokens, next) == "or") {
  define op := val(tokens, next)
  define right_result := parse_compare(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  left := node("binary", op, left, get(right_result, "ast"), ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_program(tokens) {
 define ast := array()
 define pos := 0
 define err := ""
 repeat pos < len(tokens) and err == "" {
  define start := at(tokens, pos)
  define ln := get(start, "line")
  define kw := get(start, "value")
  if kw == "define" {
   if pos + 2 >= len(tokens) {
    err := "incomplete define statement"
   } otherwise {
    define name_token := at(tokens, pos + 1)
    if get(name_token, "kind") != "identifier" or val(tokens, pos + 2) != ":=" {
     err := "expected define name := expression"
    } otherwise {
     define expr := parse_expr(tokens, pos + 3)
     if get(expr, "error") != "" {
      err := get(expr, "error")
     } otherwise {
      if get(expr, "pos") == pos + 3 {
       err := "expected expression after :="
      } otherwise {
       ast := push(ast, node("define", get(name_token, "value"), get(expr, "ast"), "", ln))
       pos := get(expr, "pos")
      }
     }
    }
   }
  } otherwise {
   if kw == "show" {
    define expr := parse_expr(tokens, pos + 1)
    if get(expr, "error") != "" {
     err := get(expr, "error")
    } otherwise {
     if get(expr, "pos") == pos + 1 {
      err := "expected expression after show"
     } otherwise {
      ast := push(ast, node("show", "", get(expr, "ast"), "", ln))
      pos := get(expr, "pos")
     }
    }
   } otherwise {
    err := "unsupported statement"
   }
  }
  if pos < len(tokens) and line_at(tokens, pos) == ln and err == "" {
   err := "unexpected token at end of statement"
  }
 }
 return map("ast", ast, "error", err)
}

# Character-level lexer written in Zenvora. Tokens include kind/value/line/column.
fn space(c) {
 return c == " " or c == "\t" or c == "\n" or c == "\r"
}
fn letter(c) {
 return index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0
}
fn digit(c) {
 return index_of("0123456789", c) >= 0
}
fn word(c) {
 return letter(c) or digit(c)
}
fn token(k, v, l, c) {
 return map("kind", k, "value", v, "line", l, "column", c)
}

fn lex(source) {
 define out := array()
 define n := char_count(source)
 define i := 0
 define line := 1
 define col := 1
 define start_line := 1
 define start_col := 1
 define c := ""
 define d := ""
 define v := ""
 define k := ""
 define err := ""
 define closed := false
 repeat i < n and err == "" {
  c := char_at(source, i)
  if space(c) {
   if c == "\n" {
    line := line + 1
    col := 1
   } otherwise {
    col := col + 1
   }
   i := i + 1
  } otherwise {
   if c == "#" {
    repeat i < n and char_at(source, i) != "\n" {
     i := i + 1
     col := col + 1
    }
   } otherwise {
    start_line := line
    start_col := col
    v := ""
    if c == "\"" {
     k := "string"
     closed := false
     i := i + 1
     col := col + 1
     repeat i < n and not closed and err == "" {
      c := char_at(source, i)
      if c == "\"" {
       closed := true
       i := i + 1
       col := col + 1
      } otherwise {
       if c == "\\" {
        i := i + 1
        col := col + 1
        if i >= n {
         err := "unterminated escape"
        } otherwise {
         d := char_at(source, i)
         if d == "n" {
          v := v + "\n"
         } otherwise {
          if d == "t" {
           v := v + "\t"
          } otherwise {
           if d == "r" {
            v := v + "\r"
           } otherwise {
            if d == "\"" or d == "\\" {
             v := v + d
            } otherwise {
             err := "unsupported escape"
            }
           }
          }
         }
         i := i + 1
         col := col + 1
        }
       } otherwise {
        if c == "\n" {
         err := "newline in string literal"
        } otherwise {
         v := v + c
         i := i + 1
         col := col + 1
        }
       }
      }
     }
     if err == "" and not closed {
      err := "unterminated string literal"
     }
     if err == "" {
      out := push(out, token(k, v, start_line, start_col))
     }
    } otherwise {
     if letter(c) {
      k := "identifier"
      repeat i < n and word(char_at(source, i)) {
       v := v + char_at(source, i)
       i := i + 1
       col := col + 1
      }
      if v == "define" or v == "show" or v == "fn" or v == "call" or v == "return" or v == "if" or v == "otherwise" or v == "repeat" or v == "break" or v == "continue" or v == "use" or v == "contract" or v == "state" or v == "action" or v == "view" {
       k := "keyword"
      } otherwise {
       if v == "true" or v == "false" {
        k := "boolean"
       } otherwise {
        if v == "and" or v == "or" or v == "not" {
         k := "operator"
        }
       }
      }
      out := push(out, token(k, v, start_line, start_col))
     } otherwise {
      if digit(c) {
       k := "number"
       repeat i < n and digit(char_at(source, i)) {
        v := v + char_at(source, i)
        i := i + 1
        col := col + 1
       }
       out := push(out, token(k, v, start_line, start_col))
      } otherwise {
       d := ""
       if i + 1 < n {
        d := char_at(source, i + 1)
       }
       if (c == ":" and d == "=") or (c == "=" and d == "=") or (c == "!" and d == "=") or (c == "<" and d == "=") or (c == ">" and d == "=") {
        v := c + d
        k := "operator"
        i := i + 2
        col := col + 2
        out := push(out, token(k, v, start_line, start_col))
       } otherwise {
        v := c
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "=" or c == "<" or c == ">" or c == "!" {
         k := "operator"
        } otherwise {
         if c == "(" or c == ")" or c == "[" or c == "]" or c == "{" or c == "}" or c == "," {
          k := "punctuation"
         } otherwise {
          err := "unexpected character"
         }
        }
        if err == "" {
         out := push(out, token(k, v, start_line, start_col))
         i := i + 1
         col := col + 1
        }
       }
      }
     }
    }
   }
  }
 }
 return map("tokens", out, "error", err)
}

define parser_source := "define answer := 2 + 3 * 4\nshow answer\n"
define lexed := lex(parser_source)
define parsed := parse_program(get(lexed, "tokens"))
assert(get(lexed, "error") == "", "lexer failed on parser fixture")
assert(get(parsed, "error") == "", "parser failed on valid fixture")
define first := get(get(parsed, "ast"), 0)
assert(get(first, "kind") == "define", "first AST node should be define")
assert(get(get(first, "left"), "value") == "+", "addition should be the root expression")
define multiplied := get(get(first, "left"), "right")
assert(get(multiplied, "value") == "*", "multiplication must bind tighter than addition")
define bad_lexed := lex("define broken :=\n")
define bad_parse := parse_program(get(bad_lexed, "tokens"))
assert(get(bad_parse, "error") != "", "missing expression must be rejected")
show parsed
