# Zenvora-written recursive-descent parser foundation.
# Current supported statements: define name := expression; show expression.
# Expressions: literals, names, parentheses, *, /, +, -, comparisons, and/or.
fn node(kind, value, left, right, line) {
 return map("kind", kind, "value", value, "left", left, "right", right, "line", line)
}
fn result(ast, pos, err) {
 return map("ast", ast, "pos", pos, "error", err)
}
fn at(tokens, pos) {
 return get(tokens, pos)
}
fn parse_primary(tokens, pos) {
 if pos >= len(tokens) {
  return result("", pos, "expected expression")
 }
 define t := at(tokens, pos)
 define kind := get(t, "kind")
 define value := get(t, "value")
 define ln := get(t, "line")
 if kind == "number" {
  return result(node("number", value, "", "", ln), pos + 1, "")
 } otherwise {
  if kind == "string" {
   return result(node("string", value, "", "", ln), pos + 1, "")
  } otherwise {
   if kind == "boolean" {
    return result(node("boolean", value, "", "", ln), pos + 1, "")
   } otherwise {
    if kind == "identifier" {
     return result(node("name", value, "", "", ln), pos + 1, "")
    } otherwise {
     if value == "(" {
      define nested := parse_expr(tokens, pos + 1)
      if get(nested, "error") != "" {
       return nested
      }
      define close_pos := get(nested, "pos")
      if close_pos >= len(tokens) or get(at(tokens, close_pos), "value") != ")" {
       return result("", close_pos, "expected closing parenthesis")
      }
      return result(get(nested, "ast"), close_pos + 1, "")
     } otherwise {
      return result("", pos, "expected literal, name, or parenthesized expression")
     }
    }
   }
  }
 }
}

fn parse_mul(tokens, pos) {
 define left_result := parse_primary(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "*" or get(at(tokens, next), "value") == "/") {
  define op := get(at(tokens, next), "value")
  define right_result := parse_primary(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  define right_ast := get(right_result, "ast")
  left := node("binary", op, left, right_ast, ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_add(tokens, pos) {
 define left_result := parse_mul(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "+" or get(at(tokens, next), "value") == "-") {
  define op := get(at(tokens, next), "value")
  define right_result := parse_mul(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  define right_ast := get(right_result, "ast")
  left := node("binary", op, left, right_ast, ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_compare(tokens, pos) {
 define left_result := parse_add(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "==" or get(at(tokens, next), "value") == "!=" or get(at(tokens, next), "value") == "<" or get(at(tokens, next), "value") == "<=" or get(at(tokens, next), "value") == ">" or get(at(tokens, next), "value") == ">=") {
  define op := get(at(tokens, next), "value")
  define right_result := parse_add(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  define right_ast := get(right_result, "ast")
  left := node("binary", op, left, right_ast, ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_expr(tokens, pos) {
 define left_result := parse_compare(tokens, pos)
 if get(left_result, "error") != "" {
  return left_result
 }
 define left := get(left_result, "ast")
 define next := get(left_result, "pos")
 define ln := get(left, "line")
 repeat next < len(tokens) and get(at(tokens, next), "line") == ln and (get(at(tokens, next), "value") == "and" or get(at(tokens, next), "value") == "or") {
  define op := get(at(tokens, next), "value")
  define right_result := parse_compare(tokens, next + 1)
  if get(right_result, "error") != "" {
   return right_result
  }
  define right_ast := get(right_result, "ast")
  left := node("binary", op, left, right_ast, ln)
  next := get(right_result, "pos")
 }
 return result(left, next, "")
}

fn parse_program(tokens) {
 define ast := array()
 define pos := 0
 define err := ""
 repeat pos < len(tokens) and err == "" {
  define start := at(tokens, pos)
  define ln := get(start, "line")
  define kw := get(start, "value")
  if kw == "define" {
   if pos + 2 >= len(tokens) {
    err := "incomplete define statement"
   } otherwise {
    define name_token := at(tokens, pos + 1)
    if get(name_token, "kind") != "identifier" or get(at(tokens, pos + 2), "value") != ":=" {
     err := "expected define name := expression"
    } otherwise {
     define expr := parse_expr(tokens, pos + 3)
     if get(expr, "error") != "" {
      err := get(expr, "error")
     } otherwise {
      if get(expr, "pos") == pos + 3 {
       err := "expected expression after :="
      } otherwise {
       define name_value := get(name_token, "value")
       define define_expr_ast := get(expr, "ast")
       define define_statement_node := node("define", name_value, define_expr_ast, "", ln)
       ast := push(ast, define_statement_node)
       pos := get(expr, "pos")
      }
     }
    }
   }
  } otherwise {
   if kw == "show" {
    define expr := parse_expr(tokens, pos + 1)
    if get(expr, "error") != "" {
     err := get(expr, "error")
    } otherwise {
     if get(expr, "pos") == pos + 1 {
      err := "expected expression after show"
     } otherwise {
      define show_expr_ast := get(expr, "ast")
      define show_statement_node := node("show", "", show_expr_ast, "", ln)
      ast := push(ast, show_statement_node)
      pos := get(expr, "pos")
     }
    }
   } otherwise {
    err := "unsupported statement"
   }
  }
  if pos < len(tokens) and get(at(tokens, pos), "line") == ln and err == "" {
   err := "unexpected token at end of statement"
  }
 }
 return map("ast", ast, "error", err)
}

# Character-level lexer written in Zenvora. Tokens include kind/value/line/column.
fn space(c) {
 return c == " " or c == "\t" or c == "\n" or c == "\r"
}
fn letter(c) {
 return index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0
}
fn digit(c) {
 return index_of("0123456789", c) >= 0
}
fn word(c) {
 return letter(c) or digit(c)
}
fn token(k, v, l, c) {
 return map("kind", k, "value", v, "line", l, "column", c)
}

fn lex(source) {
 define out := array()
 define n := char_count(source)
 define i := 0
 define line := 1
 define col := 1
 define start_line := 1
 define start_col := 1
 define c := ""
 define d := ""
 define v := ""
 define k := ""
 define err := ""
 define closed := false
 repeat i < n and err == "" {
  c := char_at(source, i)
  if space(c) {
   if c == "\n" {
    line := line + 1
    col := 1
   } otherwise {
    col := col + 1
   }
   i := i + 1
  } otherwise {
   if c == "#" {
    repeat i < n and char_at(source, i) != "\n" {
     i := i + 1
     col := col + 1
    }
   } otherwise {
    start_line := line
    start_col := col
    v := ""
    if c == "\"" {
     k := "string"
     closed := false
     i := i + 1
     col := col + 1
     repeat i < n and not closed and err == "" {
      c := char_at(source, i)
      if c == "\"" {
       closed := true
       i := i + 1
       col := col + 1
      } otherwise {
       if c == "\\" {
        i := i + 1
        col := col + 1
        if i >= n {
         err := "unterminated escape"
        } otherwise {
         d := char_at(source, i)
         if d == "n" {
          v := v + "\n"
         } otherwise {
          if d == "t" {
           v := v + "\t"
          } otherwise {
           if d == "r" {
            v := v + "\r"
           } otherwise {
            if d == "\"" or d == "\\" {
             v := v + d
            } otherwise {
             err := "unsupported escape"
            }
           }
          }
         }
         i := i + 1
         col := col + 1
        }
       } otherwise {
        if c == "\n" {
         err := "newline in string literal"
        } otherwise {
         v := v + c
         i := i + 1
         col := col + 1
        }
       }
      }
     }
     if err == "" and not closed {
      err := "unterminated string literal"
     }
     if err == "" {
      out := push(out, token(k, v, start_line, start_col))
     }
    } otherwise {
     if letter(c) {
      k := "identifier"
      repeat i < n and word(char_at(source, i)) {
       v := v + char_at(source, i)
       i := i + 1
       col := col + 1
      }
      if v == "define" or v == "show" or v == "fn" or v == "call" or v == "return" or v == "if" or v == "otherwise" or v == "repeat" or v == "break" or v == "continue" or v == "use" or v == "contract" or v == "state" or v == "action" or v == "view" {
       k := "keyword"
      } otherwise {
       if v == "true" or v == "false" {
        k := "boolean"
       } otherwise {
        if v == "and" or v == "or" or v == "not" {
         k := "operator"
        }
       }
      }
      out := push(out, token(k, v, start_line, start_col))
     } otherwise {
      if digit(c) {
       k := "number"
       repeat i < n and digit(char_at(source, i)) {
        v := v + char_at(source, i)
        i := i + 1
        col := col + 1
       }
       out := push(out, token(k, v, start_line, start_col))
      } otherwise {
       d := ""
       if i + 1 < n {
        d := char_at(source, i + 1)
       }
       if (c == ":" and d == "=") or (c == "=" and d == "=") or (c == "!" and d == "=") or (c == "<" and d == "=") or (c == ">" and d == "=") {
        v := c + d
        k := "operator"
        i := i + 2
        col := col + 2
        out := push(out, token(k, v, start_line, start_col))
       } otherwise {
        v := c
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "=" or c == "<" or c == ">" or c == "!" {
         k := "operator"
        } otherwise {
         if c == "(" or c == ")" or c == "[" or c == "]" or c == "{" or c == "}" or c == "," {
          k := "punctuation"
         } otherwise {
          err := "unexpected character"
         }
        }
        if err == "" {
         out := push(out, token(k, v, start_line, start_col))
         i := i + 1
         col := col + 1
        }
       }
      }
     }
    }
   }
  }
 }
 return map("tokens", out, "error", err)
}

define parser_source := "define answer := 2 + 3 * 4\nshow answer\n"
define lexed := lex(parser_source)
define parser_tokens := get(lexed, "tokens")
define parsed := parse_program(parser_tokens)
define parsed_ast := get(parsed, "ast")
define first := get(parsed_ast, 0)
define first_expr := get(first, "left")
define multiplied := get(first_expr, "right")
define bad_lexed := lex("define broken :=\n")
define bad_tokens := get(bad_lexed, "tokens")
define bad_parse := parse_program(bad_tokens)
show get(lexed, "error")
show get(parsed, "error")
show get(first, "kind")
show get(first_expr, "value")
show get(multiplied, "value")
show get(bad_parse, "error")
show parsed
