# Regression: braces inside string tokens must not terminate a function body.
define brace_string_source := "fn braces() {\nshow \"}\"\nshow \"{\"\n}\nshow \"done\"\n"
define brace_string_lexed := lex(brace_string_source)
define brace_string_parse := parse_program(get(brace_string_lexed, "tokens"))
if get(brace_string_parse, "error") == "" and len(get(brace_string_parse, "ast")) == 2 {
  show "ZENVORA_BRACE_STRING_PASS"
} otherwise {
  show "ZENVORA_BRACE_STRING_FAIL"
}
show parsed

# Minimal Zenvora-written bytecode-plan VM. This executes emitted instructions in Zenvora,
# rather than asking the Rust reference VM to execute the plan.
fn pop_stack(stack) {
  if len(stack) == 0 {
    return map("stack", stack, "value", "", "error", "operand stack underflow")
  }
  define last := get(stack, len(stack) - 1)
  define rest := array()
  define i := 0
  repeat i < len(stack) - 1 {
    rest := push(rest, get(stack, i))
    i := i + 1
  }
  return map("stack", rest, "value", last, "error", "")
}
fn vm_truthy(value) {
  return value == true
}
fn vm_binary(operator, left, right) {
  if operator == "+" {
    if type_of(left) == "string" or type_of(right) == "string" {
      return map("value", to_string(left) + to_string(right), "error", "")
    }
    return map("value", left + right, "error", "")
  } otherwise {
    if operator == "-" {
      return map("value", left - right, "error", "")
    } otherwise {
      if operator == "*" {
        return map("value", left * right, "error", "")
      } otherwise {
        if operator == "/" {
          if right == 0 {
            return map("value", 0, "error", "division by zero")
          }
          return map("value", left / right, "error", "")
        } otherwise {
          if operator == "==" {
            return map("value", left == right, "error", "")
          } otherwise {
            if operator == "!=" {
              return map("value", left != right, "error", "")
            } otherwise {
              if operator == "<" {
                return map("value", left < right, "error", "")
              } otherwise {
                if operator == "<=" {
                  return map("value", left <= right, "error", "")
                } otherwise {
                  if operator == ">" {
                    return map("value", left > right, "error", "")
                  } otherwise {
                    if operator == ">=" {
                      return map("value", left >= right, "error", "")
                    } otherwise {
                      if operator == "and" {
                        return map("value", left and right, "error", "")
                      } otherwise {
                        if operator == "or" {
                          return map("value", left or right, "error", "")
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return map("value", "", "error", "unsupported binary operator: " + operator)
}
fn execute_plan_code(code, initial_env, initial_output, functions, call_depth) {
  if call_depth > 64 {
    return map("environment", initial_env, "output", initial_output, "error", "function call depth limit exceeded", "returned", false, "return_value", "")
  }
  define env := initial_env
  define output := initial_output
  define stack := array()
  define pc := 0
  define steps := 0
  define err := ""
  define returned := false
  define return_value := ""
  repeat pc < len(code) and err == "" and not returned and steps < 500 {
    steps := steps + 1
    define ins := get(code, pc)
    define op := get(ins, "op")
    if op == "push_const" {
      define value := get(ins, "value")
      if get(ins, "type") == "number" {
        value := to_int(value)
      } otherwise {
        if get(ins, "type") == "boolean" {
          value := value == "true"
        }
      }
      stack := push(stack, value)
    } otherwise {
      if op == "load" {
        define name := get(ins, "name")
        if not contains(env, name) {
          err := "undefined variable: " + name
        } otherwise {
          stack := push(stack, get(env, name))
        }
      } otherwise {
        if op == "declare" or op == "store" {
          define popped := pop_stack(stack)
          stack := get(popped, "stack")
          if get(popped, "error") != "" {
            err := get(popped, "error")
          } otherwise {
            env := put(env, get(ins, "name"), get(popped, "value"))
          }
        } otherwise {
          if op == "print" {
            define popped := pop_stack(stack)
            stack := get(popped, "stack")
            if get(popped, "error") != "" {
              err := get(popped, "error")
            } otherwise {
              output := push(output, to_string(get(popped, "value")))
            }
          } otherwise {
            if op == "unary" {
              define popped := pop_stack(stack)
              stack := get(popped, "stack")
              if get(popped, "error") != "" {
                err := get(popped, "error")
              } otherwise {
                define value := get(popped, "value")
                define operator := get(ins, "operator")
                if operator == "-" {
                  stack := push(stack, 0 - value)
                } otherwise {
                  if operator == "!" or operator == "not" {
                    stack := push(stack, not value)
                  } otherwise {
                    err := "unsupported unary operator: " + operator
                  }
                }
              }
            } otherwise {
              if op == "binary" {
                define right := pop_stack(stack)
                stack := get(right, "stack")
                define left := pop_stack(stack)
                stack := get(left, "stack")
                if get(right, "error") != "" or get(left, "error") != "" {
                  err := "operand stack underflow"
                } otherwise {
                  define evaluated := vm_binary(get(ins, "operator"), get(left, "value"), get(right, "value"))
                  if get(evaluated, "error") != "" {
                    err := get(evaluated, "error")
                  } otherwise {
                    stack := push(stack, get(evaluated, "value"))
                  }
                }
              } otherwise {
                if op == "index" {
                  define index_value := pop_stack(stack)
                  stack := get(index_value, "stack")
                  define collection := pop_stack(stack)
                  stack := get(collection, "stack")
                  if get(index_value, "error") != "" or get(collection, "error") != "" {
                    err := "operand stack underflow"
                  } otherwise {
                    define index := get(index_value, "value")
                    define target := get(collection, "value")
                    if type_of(index) != "integer" or index < 0 or index >= len(target) {
                      err := "invalid collection index"
                    } otherwise {
                      stack := push(stack, get(target, index))
                    }
                  }
                } otherwise {
                  if op == "jump" {
                    pc := get(ins, "target") - 1
                  } otherwise {
                    if op == "jump_if_false" {
                      define popped := pop_stack(stack)
                      stack := get(popped, "stack")
                      if get(popped, "error") != "" {
                        err := get(popped, "error")
                      } otherwise {
                        if not get(popped, "value") {
                          pc := get(ins, "target") - 1
                        }
                      }
                    } otherwise {
                      if op == "call" {
                        define fn_name := get(ins, "name")
                        define argc := get(ins, "argc")
                        define args := array()
                        define arg_pos := 0
                        if len(stack) < argc {
                          err := "operand stack underflow in function call"
                        } otherwise {
                          repeat arg_pos < argc {
                            define popped_arg := pop_stack(stack)
                            stack := get(popped_arg, "stack")
                            args := push(args, get(popped_arg, "value"))
                            arg_pos := arg_pos + 1
                          }
                          define fn_index := 0
                          define found_fn := false
                          repeat fn_index < len(functions) and not found_fn and err == "" {
                            define fn_record := get(functions, fn_index)
                            if get(fn_record, "name") == fn_name {
                              found_fn := true
                              define params := get(fn_record, "parameters")
                              if len(params) != argc {
                                err := "function argument count mismatch: " + fn_name
                              } otherwise {
                                define fn_env := env
                                define param_pos := 0
                                repeat param_pos < len(params) {
                                  fn_env := put(fn_env, get(params, param_pos), get(args, argc - param_pos - 1))
                                  param_pos := param_pos + 1
                                }
                                define called := execute_plan_code(get(fn_record, "code"), fn_env, output, functions, call_depth + 1)
                                output := get(called, "output")
                                if get(called, "error") != "" {
                                  err := get(called, "error")
                                } otherwise {
                                  stack := push(stack, get(called, "return_value"))
                                }
                              }
                            }
                            fn_index := fn_index + 1
                          }
                          if not found_fn and err == "" {
                            err := "undefined function: " + fn_name
                          }
                        }
                      } otherwise {
                        if op == "return" {
                          returned := true
                          if len(stack) > 0 {
                            define popped_return := pop_stack(stack)
                            stack := get(popped_return, "stack")
                            return_value := get(popped_return, "value")
                          }
                        } otherwise {
                          err := "unsupported VM opcode: " + op
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    pc := pc + 1
  }
  if pc < len(code) and err == "" and not returned {
    err := "instruction limit exceeded"
  }
  return map("environment", env, "output", output, "error", err, "returned", returned, "return_value", return_value)
}
fn execute_bytecode_plan(plan) {
  define verification := verify_bytecode_plan(plan)
  if not get(verification, "ok") {
    return map("ok", false, "output", array(), "error", get(verification, "error"))
  }
  define executed := execute_plan_code(get(plan, "main"), map(), array(), get(plan, "functions"), 0)
  return map("ok", get(executed, "error") == "", "output", get(executed, "output"), "error", get(executed, "error"), "environment", get(executed, "environment"))
}

# Exercise the Zenvora-written AST-to-IR lowering on the parsed source above.
define lowered_ir := lower_program(parsed_ast)
show "ZENVORA_IR"
show lowered_ir

define bytecode_plan := emit_bytecode_plan(lowered_ir)
show "ZENVORA_BYTECODE_PLAN"
show bytecode_plan

define valid_semantic_lexed := lex("define total := 0\nfn count_down(n) {\nrepeat n > 0 {\nif n > 2 {\nbreak\n} otherwise {\ncontinue\n}\n}\nreturn n\n}\n")
define valid_semantic_ast := parse_program(get(valid_semantic_lexed, "tokens"))
define valid_semantic_result := validate_program(get(valid_semantic_ast, "ast"))
define bad_call_lexed := lex("fn one(a) {\nreturn a\n}\nshow missing(1)\n")
define bad_call_ast := parse_program(get(bad_call_lexed, "tokens"))
define bad_call_result := validate_program(get(bad_call_ast, "ast"))
define bad_arity_lexed := lex("fn one(a) {\nreturn a\n}\nshow one(1, 2)\n")
define bad_arity_ast := parse_program(get(bad_arity_lexed, "tokens"))
define bad_arity_result := validate_program(get(bad_arity_ast, "ast"))
define invalid_break_lexed := lex("break\n")
define invalid_break_ast := parse_program(get(invalid_break_lexed, "tokens"))
define invalid_break_result := validate_program(get(invalid_break_ast, "ast"))
define invalid_return_lexed := lex("return 1\n")
define invalid_return_ast := parse_program(get(invalid_return_lexed, "tokens"))
define invalid_return_result := validate_program(get(invalid_return_ast, "ast"))
show "ZENVORA_SEMANTICS"
show valid_semantic_result
show get(bad_call_result, "error")
show get(bad_arity_result, "error")
show get(invalid_break_result, "error")
show get(invalid_return_result, "error")

define bytecode_verification := verify_bytecode_plan(bytecode_plan)
show "ZENVORA_BYTECODE_VERIFY"
show bytecode_verification
define runnable_source := "define answer := 2 + 3 * 4\nshow answer\nfn add(a, b) {\nreturn a + b\n}\nshow add(20, 22)\nfn choose(a, b) {\nif a > 0 {\nreturn add(a, b)\n} otherwise {\nreturn b\n}\n}\nshow choose(2, 5)\nshow choose(0, 7)\nfn factorial(n) {\nif n <= 1 {\nreturn 1\n} otherwise {\nreturn n * factorial(n - 1)\n}\n}\nshow factorial(5)\n"
define runnable_lexed := lex(runnable_source)
define runnable_ast_result := parse_program(get(runnable_lexed, "tokens"))
define runnable_ir := lower_program(get(runnable_ast_result, "ast"))
define runnable_plan := emit_bytecode_plan(runnable_ir)
define runnable_result := execute_bytecode_plan(runnable_plan)
define runnable_output := get(runnable_result, "output")
show "ZENVORA_VM"
show runnable_result
if get(runnable_result, "ok") and len(runnable_output) == 5 and get(runnable_output, 0) == "14" and get(runnable_output, 1) == "42" and get(runnable_output, 2) == "7" and get(runnable_output, 3) == "7" and get(runnable_output, 4) == "120" {
  show "ZENVORA_VM_ASSERTIONS_PASS"
} otherwise {
  show "ZENVORA_VM_ASSERTIONS_FAIL"
}

# Resource-limit regressions: malicious plans must terminate instead of hanging or overflowing the host stack.
define recursive_source := "fn recurse(n) {\nreturn recurse(n + 1)\n}\nshow recurse(0)\n"
define recursive_lexed := lex(recursive_source)
define recursive_ast := parse_program(get(recursive_lexed, "tokens"))
define recursive_ir := lower_program(get(recursive_ast, "ast"))
define recursive_plan := emit_bytecode_plan(recursive_ir)
define recursive_result := execute_bytecode_plan(recursive_plan)
show get(recursive_result, "error")

define runaway_source := "repeat true {\ndefine counter := 1\n}\n"
define runaway_lexed := lex(runaway_source)
define runaway_ast := parse_program(get(runaway_lexed, "tokens"))
define runaway_ir := lower_program(get(runaway_ast, "ast"))
define runaway_plan := emit_bytecode_plan(runaway_ir)
define runaway_result := execute_bytecode_plan(runaway_plan)
show get(runaway_result, "error")
